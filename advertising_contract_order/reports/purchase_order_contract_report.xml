<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <template id="contract_purchase_order" inherit_id="purchase.report_purchaseorder_document">
            <xpath expr="//div[@id='informations']" position="after">
                <t t-if="o.is_contract">
                    <div class="row">
                <div t-if="o.certification_number" class="col-3 bm-2">
                    <strong>Certification Number:</strong>
                    <p t-field="o.certification_number" class="m-0"/>
                </div>
                <div t-if="o.contract_number" class="col-3 bm-2">
                    <strong>Contract Number:</strong>
                    <p t-field="o.contract_number" class="m-0"/>
                </div>
                <div t-if="o.contract_date_from" class="col-3 bm-2">
                    <strong>Date From:</strong>
                    <p t-field="o.contract_date_from" class="m-0"/>
                </div>
                <div t-if="o.contract_date_end" class="col-3 bm-2">
                    <strong>Date End:</strong>
                    <p t-field="o.contract_date_end" class="m-0"/>
                </div>
                </div>
            </t>
            </xpath>
        </template>   
</odoo>
