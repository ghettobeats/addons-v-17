<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_property_form" model="ir.ui.view">
        <field name="name">res.partner.internal.services.config</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
	    <page name="accounting" position="inside">
		<group name="internal_services_config_container">
		    <group name="internal_services_config">
			<field name="internal_services" />
			<field
			    name="internal_services_journal_id"
			    attrs="{'invisible': [('internal_services', '=', False)], 'required': [('internal_services', '=', True)]}"/>
		    </group>
		</group>
	    </page>
	</field>
    </record>
</odoo>
