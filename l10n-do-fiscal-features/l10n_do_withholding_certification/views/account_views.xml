<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_form_inherited" model="ir.ui.view">
        <field name="name">view.account.form.inherited</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="deprecated" position="after">
                <field name="is_l10n_do_withholding_account"/>
                <field name="l10n_do_legal_base"
                       attrs="{'invisible': [('is_l10n_do_withholding_account', '=', False)]}"/>
                <field name="l10n_do_tax_name"
                       attrs="{'invisible': [('is_l10n_do_withholding_account', '=', False)]}"/>
            </field>
        </field>
    </record>

    <record id="view_account_payment_search_inherited" model="ir.ui.view">
        <field name="name">view.account.payment.search.inherited</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="state_sent" position="after">
                <filter string="Has Withholding"
                        name="has_l10n_do_withholding_filter"
                        domain="[('has_l10n_do_withholding','=',True)]"/>
            </filter>
        </field>
    </record>

    <record id="view_account_payment_form_inherited" model="ir.ui.view">
        <field name="name">view.account.payment.form.inherited</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="is_reconciled" position="after">
                <field name="has_l10n_do_withholding" invisible="1"/>
            </field>
            <xpath expr="//button[@name='action_draft']" position="after">
                <button name="withholding_print" attrs="{'invisible': ['|', ('payment_type', '!=', 'outbound'), ('has_l10n_do_withholding', '=', False)]}"
                        string="Print Certification" type="object"/>
            </xpath>
        </field>
    </record>

</odoo>
