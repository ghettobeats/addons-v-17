<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="withholding_layout_setup_wizard_form" model="ir.ui.view">
        <field name="name">withholding.layout.setup.wizard.form</field>
        <field name="model">withholding.layout.setup.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="l10n_do_withholding_cert_type"/>
                        <field name="l10n_do_show_header"
                               attrs="{'invisible': [('l10n_do_withholding_cert_type', '!=', 'gov')]}"/>
                        <field name="l10n_do_show_footer"
                               attrs="{'invisible': [('l10n_do_withholding_cert_type', '!=', 'gov')]}"/>
                    </group>
                </group>
                <group>
                    <field name="l10n_do_year_tag_line"
                           attrs="{'invisible': [('l10n_do_withholding_cert_type', '!=', 'gov')]}"/>
                </group>
                <group>
                    <field name="l10n_do_sign_table"/>
                </group>
                <footer>
                    <button special="save" string="Save"
                                class="btn btn-primary" type="object" />
                        <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
