<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="l10n_do_account_journal_document_type_view_tree" model="ir.ui.view">
        <field name="name">l10n_do.account.journal.document_type.view.tree</field>
        <field name="model">l10n_do.account.journal.document_type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="l10n_latam_document_type_id"/>
                <field name="auth_number"/>
                <field name="l10n_do_next_sequence" string="Next Number"/>
                <field name="state"/>
                <field name="journal_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" groups="base.group_no_one"/>
            </tree>
        </field>
    </record>

    <record id="l10n_do_account_journal_document_type_view_form" model="ir.ui.view">
        <field name="name">l10n_do.account.journal.document_type.view.form</field>
        <field name="model">l10n_do.account.journal.document_type</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight"
                            attrs="{'invisible':[('state','!=', 'draft')]}"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            attrs="{'invisible':[('state','!=', 'valid')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <group>
                        <div class="oe_title">
                            <h2>
                                <field name="l10n_latam_document_type_id" invisible="1"/>
                                <field name="l10n_do_ncf_type" invisible="1"/>
                                <field name="auth_number" readonly="1"/>
                            </h2>
                        </div>
                    </group>
                    <group>
                        <group>
                            <field name="l10n_latam_document_type_id" readonly="1"/>
                            <field name="auth_number" required="1"/>
                            <field name="sequence_start" required="1"/>
                            <field name="sequence_end" required="1"/>
                            <field name="l10n_do_ncf_expiration_date"
                                   attrs="{
                                   'required': [('l10n_latam_document_type_id', '!=', False), ('l10n_do_ncf_type', 'not in', ('e-consumer', 'e-credit_note', 'consumer'))],
                                   'invisible': [('l10n_do_ncf_type', 'in', ('e-consumer', 'e-credit_note', 'consumer'))]
                                   }"/>
                        </group>
                        <group>
                            <field name="l10n_do_next_sequence"/>
                            <field name="l10n_do_sequence_remaining"/>
                            <field name="active" groups="base.group_no_one"/>
                            <field name="journal_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Queued Sequences" name="queued_pool">
                            <field name="queued_pool_ids">
                                <tree editable="bottom"
                                      decoration-info="state=='queue'"
                                      decoration-success="state=='active'"
                                      decoration-muted="state in ('depleted', 'expired', 'cancelled')">
                                    <field name="l10n_do_ncf_type" invisible="1"/>
                                    <field name="name"/>
                                    <field name="expiration_date"
                                           attrs="{'invisible': [('l10n_do_ncf_type', 'in', ('e-consumer', 'e-credit_note', 'consumer'))]}"/>
                                    <field name="sequence_start"/>
                                    <field name="sequence_end" required="1"/>
                                    <field name="state" readonly="1"/>
                                    <button name="action_queue"
                                            type="object" icon="fa-check" width="0.1"
                                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                                    <button name="action_cancel"
                                            type="object" icon="fa-archive" width="0.1"
                                            attrs="{'invisible': [('state', 'in', ('depleted', 'expired', 'cancelled'))]}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"
                           groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="l10n_do_account_journal_document_type_view_search" model="ir.ui.view">
        <field name="name">l10n_do.account.journal.document_type.view.search</field>
        <field name="model">l10n_do.account.journal.document_type</field>
        <field name="arch" type="xml">
            <search string="Document Pools">
                <field name="auth_number"/>
                <field name="l10n_latam_document_type_id"/>
                <field name="journal_id"/>
                <separator/>
                <filter name="active" string="Archived"
                        domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="state"
                            context="{'group_by':'state'}"/>
                    <filter string="Journal" name="journal"
                            context="{'group_by':'journal_id'}"/>
                    <filter string="Company" name="company"
                            groups="base.group_multi_company"
                            context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_journal_document_type" model="ir.actions.act_window">
        <field name="name">Document Pools</field>
        <field name="res_model">l10n_do.account.journal.document_type</field>
        <field name="domain">[('l10n_latam_document_type_id', '!=', False)]</field>
        <field name="search_view_id" ref="l10n_do_account_journal_document_type_view_search"/>
        <field name="view_ids"
               eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'tree', 'view_id': ref('l10n_do_account_journal_document_type_view_tree')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('l10n_do_account_journal_document_type_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_neutral_face">
                No document type sequences found for this company
            </p>
            <p>
                Enable advance sequence management from Invoicing settings
            </p>
        </field>
    </record>

    <menuitem action="action_journal_document_type" id="menu_journal_document_type" sequence="30"
              parent="account.account_account_menu"/>

    <record id="view_account_journal_form_inherited" model="ir.ui.view">
        <field name="name">view.account.journal.form.inherited</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="l10n_do_accounting.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="l10n_do_ncf_expiration_date" position="after">
                <field name="state" invisible="1"/>
            </field>
            <xpath expr="//field[@name='l10n_do_document_type_ids']/tree/field[@name='l10n_do_ncf_expiration_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!--<xpath expr="//field[@name='l10n_do_document_type_ids']/tree/field[@name='l10n_do_next_sequence']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>-->
        </field>
    </record>

    <record id="view_move_form_inherited" model="ir.ui.view">
        <field name="name">account.move.form.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_lock_date_message']/.." position="after">
                <div groups="account.group_account_invoice"
                     class="alert alert-warning" role="alert" style="margin-bottom:0px;"
                     attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('l10n_do_sequence_message', '=', False)]}">
                    <field name="l10n_do_sequence_message" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>


</odoo>
