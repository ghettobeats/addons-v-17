<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherited</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="l10n_do_accounting.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='l10n_do_title']" position="attributes">
                <attribute name="attrs">{'invisible': False}</attribute>
            </xpath>
            <xpath expr="//div[@id='l10n_do_section']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" title="Allow employees to update their own data.">
                    <div class="o_setting_left_pane">
                        <field name="l10n_do_sequence_manager"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="l10n_do_sequence_manager"/>
                        <div class="text-muted">
                            Enable/disable advance fiscal sequence management
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 o_setting_box" attrs="{'invisible': [('l10n_do_sequence_manager', '=', False)]}">
                    <div class="o_setting_right_pane">
                        <label for="l10n_do_sequence_left"/>
                        <field name="l10n_do_sequence_left"/>
                        <div class="text-muted">
                            Before how many sequences left you want to be
                            notified
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 o_setting_box" attrs="{'invisible': [('l10n_do_sequence_manager', '=', False)]}">
                    <div class="o_setting_right_pane">
                        <label for="l10n_do_sequence_days_to_expire"/>
                        <field name="l10n_do_sequence_days_to_expire"/>
                        <div class="text-muted">
                            Between how many days left of expiring sequence you want to
                            be notified
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
