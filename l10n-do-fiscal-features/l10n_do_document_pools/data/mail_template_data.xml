<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="l10n_do_document_pools_expire_template" model="mail.template">
            <field name="name">FISCAL SEQUENCE: expire notification</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="email_from">${user.email_formatted | safe}</field>
            <field name="partner_to">${object.partner_id.id}</field>
            <field name="subject">Comprobantes Fiscales por Expirar</field>
            <field name="body_html" type="html">
<table border="0" cellpadding="0" cellspacing="0"
   style="padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;">
<tr>
    <td align="center">
        <table border="0" cellpadding="0" cellspacing="0">
            <tbody>
                <tr>
                    <td align="center" style="min-width: 1000px;">
                        <table border="0" cellpadding="0"
                               cellspacing="0" width="1000"
                               style="min-width: 1000px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                            <tr>
                                <td valign="middle">
                                    <span
                                        style="font-size: 15px; font-weight: bold;">
                                        Notificación de Comprobantes
                                        Fiscales a
                                        Expirar
                                    </span>
                                </td>
                                <td valign="middle" align="right">
                                    <img
                                        src="/logo.png?company=${object.id}"
                                        style="padding: 0px; margin: 0px; height: auto; width: 80px;"
                                        alt="${object.name}"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2"
                                    style="text-align:center;">
                                    <hr width="100%"
                                        style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:16px 0px 16px 0px;"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="center" style="min-width: 1000px;">
                        <table border="0" cellpadding="0"
                               cellspacing="0" width="1000"
                               style="min-width: 1000px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                            <tr>
                                <td valign="top"
                                    style="font-size: 13px;">
                                    <div>
                                        Los siguientes Comprobantes
                                        Fiscales están próximo a
                                        expirar:
                                        <br/>
                                        <br/>
                                        <table cellpadding="20"
                                               cellspacing="0"
                                               class="table">
                                            <thead>
                                                <tr>
                                                    <th scope="col">
                                                        Número de
                                                        Autorización
                                                    </th>
                                                    <th scope="col">
                                                        Fecha
                                                        expiración
                                                    </th>
                                                    <th scope="col">
                                                        Tipo
                                                        Comprobante
                                                    </th>
                                                    <th scope="col">
                                                        Próxima
                                                        secuencia
                                                    </th>
                                                    <th scope="col">
                                                        Restantes
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                % set expiring_sequences = object.get_expiring_sequences()
                                                % for sequence in expiring_sequences:
                                                <tr>
                                                    <td align="center">
                                                        ${sequence.auth_number}
                                                    </td>
                                                    <td align="center">
                                                        ${sequence.expiration_date}
                                                    </td>
                                                    <td align="center">
                                                        ${sequence.l10n_latam_document_type_id.name}
                                                    </td>
                                                    <td align="center">
                                                        ${sequence.number_next_actual}
                                                    </td>
                                                    <td align="center">
                                                        ${sequence.l10n_do_sequence_remaining}
                                                    </td>
                                                </tr>
                                                % endfor
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align:center;">
                                    <hr width="100%"
                                        style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <tr>
                    <td align="center" style="min-width: 1000px;">
                        <table border="0" cellpadding="0"
                               cellspacing="0" width="1000"
                               style="min-width: 1000px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;">
                            <tr>
                                <td valign="middle" align="left">
                                    ${object.name}
                                </td>
                            </tr>
                            <tr>
                                <td valign="middle" align="left"
                                    style="opacity: 0.7;">
                                    ${object.phone}
                                    % if object.email
                                    |
                                    <a href="'mailto:%s' % ${object.email}"
                                       style="text-decoration:none; color: #454748;">
                                        ${object.email}
                                    </a>
                                    % endif
                                    % if object.website
                                    |
                                    <a href="'%s' % ${object.website}"
                                       style="text-decoration:none; color: #454748;">
                                        ${object.website}
                                    </a>
                                    % endif
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </td>
</tr>
<tr>
    <td align="center" style="min-width: 1000px;">
        <table border="0" cellpadding="0" cellspacing="0"
               width="1000"
               style="min-width: 1000px; background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;">
            <tr>
                <td style="text-align: center; font-size: 13px;">
                    Powered by
                    <a target="_blank"
                       href="https://www.odoo.com?utm_source=db&amp;utm_medium=portalinvite"
                       style="color: #875A7B;">Odoo
                    </a>
                </td>
            </tr>
        </table>
    </td>
</tr>
</table>
            </field>
            <field name="lang">${object.partner_id.lang}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
