<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="l10n_do_document_pools_expire_cron" model="ir.cron">
        <field name="name">[FISCAL] Expire sequences</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="nextcall"
               eval="(DateTime.now()).replace(hour=00, minute=00, second=00, microsecond=00)"/>
        <field name="model_id" ref="model_l10n_do_account_journal_document_type"/>
        <field name="state">code</field>
        <field name="code">model._expire_sequences()</field>
    </record>

    <record id="account_fiscal_sequence_expire_notification_cron" model="ir.cron">
        <field name="name">[FISCAL] Notify Expiring Sequences</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="nextcall"
               eval="(DateTime.now()).replace(hour=00, minute=00, second=00, microsecond=00)" />
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model._expire_notification_cron()</field>
    </record>

</odoo>
