<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_payment_form_multi_inherited" model="ir.ui.view">
        <field name="name">view.account.payment.from.multi.inherited</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="payment_date" position="after">
                <field name="l10n_do_reconcile_taxes"/>
            </field>
            <field name="group_payment" position="attributes">
                <attribute name="attrs">{
                    'readonly': [('l10n_do_reconcile_taxes', '=', True)],
                }</attribute>
                <attribute name="force_save">1</attribute>
            </field>
            <xpath expr="//group[@name='group3']" position="attributes">
                <attribute name="attrs">{
                    'invisible': [
                    '|', ('payment_difference', '=', 0.0),
                    '|', ('can_edit_wizard', '=', False),
                    '|', ('l10n_do_reconcile_taxes', '=', True),
                    '&amp;', ('can_group_payments', '=', True), ('group_payment', '=', False)
                ]}</attribute>
            </xpath>
            <xpath expr="//footer" position="before">
                <field name="l10n_do_payments_invoice_ids" attrs="{'invisible': [('l10n_do_reconcile_taxes', '=', False)]}">
                    <tree create="0" editable="bottom" decoration-danger="amount &lt; 0"
                          decoration-info="amount==residual">
                      <field name="reconcile_register_id" invisible="1"/>
                      <field name="invoice_id" options="{'no_open': True}" force_save="1"/>
                      <field name="reference"/>
                      <field name="tax_ids" force_save="1"
                             widget="many2many_tags" options="{'no_create': True}"/>
                      <field name="currency_id" invisible="1"/>
                      <field name="residual" sum="Total Residual"/>
                      <field name="amount" readonly="1" force_save="1" sum="Total Amount"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>

</odoo>
