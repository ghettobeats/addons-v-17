<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="invoice_form_inherited" model="ir.ui.view">
        <field name="name">invoice.form.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_document_number']" position="before">
                <field name="l10n_do_available_service_type_detail" invisible="1"/>
                <field name="l10n_do_is_exterior" invisible="1"/>
                <field name="l10n_do_service_type" attrs="{'invisible': ['|', ('move_type', 'not in', ('in_invoice', 'in_refund')), ('l10n_do_is_exterior', '=', False)], 'required': [('l10n_do_is_exterior', '=', True)]}"/>
                <field name="l10n_do_service_type_detail" options="{'no_create': True, 'no_open': True}" domain="[('id', 'in', l10n_do_available_service_type_detail)]"
                       attrs="{'invisible': ['|', ('move_type', 'not in', ('in_invoice', 'in_refund')), ('l10n_do_is_exterior', '=', False)], 'readonly': [('l10n_do_service_type', '=', False)], 'required': [('l10n_do_service_type', '!=', False)]}"/>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="after">
                <page name="607_dgii_fields" string="DGII" groups="account.group_account_user"
                      attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund'))]}">
                    <group>
                        <group col="3" string="Withholding" groups="account.group_account_manager">
                            <field name="l10n_do_payment_date" string="Withholding date"/>
                            <field name="l10n_do_third_withheld_itbis" string="Withheld ITBIS by a third"/>
                            <field name="l10n_do_third_income_withholding" string="Income Withholding by a third"/>

                        </group>
                        <group col="3" string="Taxes" groups="account.group_account_manager">
                            <field name="l10n_do_invoiced_itbis" string="Invoiced ITBIS"/>
                            <field name="l10n_do_selective_tax" string="Selective Tax"/>
                            <field name="l10n_do_other_taxes" string="Other taxes"/>
                            <field name="l10n_do_legal_tip" string="Legal tip amount"/>
                        </group>
                        <group col="3" string="607">
                            <field name="l10n_do_fiscal_status" widget="state_selection" readonly="1"/>
                        </group>
                    </group>
                </page>
                <page name="606_dgii_fields" string="DGII" groups="account.group_account_user"
                      attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))]}">
                    <group>
                        <group col="3" string="Taxes" groups="account.group_account_manager">
                            <field name="l10n_do_invoiced_itbis" string="Invoiced ITBIS"/>
                            <field name="l10n_do_proportionality_tax" string="Proportionality Tax"/>
                            <field name="l10n_do_cost_itbis" string="Cost Itbis"/>
                            <field name="l10n_do_advance_itbis" string="Advanced ITBIS"/>
                            <field name="l10n_do_selective_tax" string="Selective Tax"/>
                            <field name="l10n_do_other_taxes" string="Other taxes"/>
                            <field name="l10n_do_legal_tip" string="Legal tip amount"/>
                        </group>
                        <group col="3" string="Invoicing" groups="account.group_account_manager">
                            <field name="l10n_do_payment_date" string="Payment date"/>
                            <field name="l10n_do_payment_form" string="Payment form"/>
                            <field name="l10n_do_service_total_amount" string="Service Total Amount"/>
                            <field name="l10n_do_good_total_amount" string="Good Total Amount"/>
                        </group>
                        <group col="3" string="Withholding" groups="account.group_account_manager">
                            <field name="l10n_do_withholded_itbis" string="Withheld ITBIS"/>
                            <field name="l10n_do_isr_withholding_type" string="ISR Withholding Type"/>
                            <field name="l10n_do_income_withholding" string="Income Withholding"/>
                        </group>
                        <group col="3" string="606">
                            <field name="l10n_do_fiscal_status" widget="state_selection" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="invoice_tree_inherited" model="ir.ui.view">
        <field name="name">invoice.tree.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="l10n_do_fiscal_status" widget="state_selection" readonly="1"
                       groups="account.group_account_user"/>
            </xpath>
        </field>
    </record>

</odoo>

