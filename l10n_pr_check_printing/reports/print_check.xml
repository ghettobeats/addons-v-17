<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="ckpr_check">
        <div class="ckpr_check">
            <t t-if="page['state'] == 'cancelled'">
                <div class="o-watermark">VOID</div>
            </t>
<!--                 <div class="sequence_number" t-if="page['sequence_number']" t-esc="page['sequence_number']" /> -->
            <div class="ckpr_date" t-esc="page['payment_date']"/>
            <!--<div class="ckpr_payee_name" t-esc="page['partner_name']"/>-->
            <div class="ckpr_amount">
                <t t-esc="page['amount'].replace(o.currency_id.symbol, '**')"/>
            </div>
            <div class="ckpr_amount_in_word" t-esc="page['amount_in_word']"/>
            <div class="ckpr_payee_addr">
                <div t-esc="page['partner_name']"/>
                <div t-esc="page['partner_street']"/>
                <div t-esc="page['partner_street2']"/>
                <div>
                    <t t-esc="page['partner_city']"/>, <t t-esc="page['partner_state']"/> <t t-esc="page['partner_zip']"/>
                </div>
            </div>
            <!--<div class="ckpr_payee_addr" t-esc="page['partner_id']" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>-->
            <!--<div class="ckpr_memo" t-esc="page['memo']"/>-->
        </div>
    </template>

    <template id="ckpr_stub">
        <div t-attf-class="ckpr_stub ckpr_stub_{{ stub_num }}">
            <div class="summary_line">
                <div class="text-left">
                    <span t-esc="page['payment_date']"/>
                </div>
                <div class="text-middle">
                    <span t-esc="page['partner_name']"/>
                </div>
<!--                     <div class="text-right sequence_number">
                    <span t-if="page['sequence_number']" t-esc="page['sequence_number']"/>
                </div> -->
            </div>

            <table class="table table-bordered table-sm stub_lines" t-if="page['stub_lines']">
                <thead><tr>
                    <th class="text-left">Invoice num</th>
                    <th class="text-left">Invoice Date</th>
                    <th class="text-left">Description</th>
                    <th class="text-left">Invoice Amount</th>
                    <th class="text-left">Withheld Amount</th>
                    <th class="text-left">Payment</th>
                </tr></thead>
                <tbody>
                    <t t-foreach="page['stub_lines']" t-as="stub_line">
                        <t t-if="stub_line.get('header')">
                            <tr><th colspan="6"><t t-esc="stub_line['name']"/></th></tr>
                        </t>
                        <t t-if="not stub_line.get('header')"><tr>
                            <td class="text-left"><t t-esc="stub_line['number']"/></td>
                            <td class="text-left"><t t-if="stub_line['date_invoice']" t-esc="stub_line['date_invoice']"/></td>
                            <td class="text-left"><t t-esc="stub_line['reference_invoice']"/></td>
                            <td class="text-right"><t t-esc="stub_line['amount_total']"/></td>
                            <td class="text-right">-</td>
                            <!--<td class="text-right"><t t-esc="stub_line['amount_residual']"/></td>-->
                            <td class="text-right"><t t-esc="stub_line['amount_paid']"/></td>
                        </tr></t>
                    </t>
                    <tr t-if="page['stub_cropped']"><td colspan="6" class="text-right">...</td></tr>
                </tbody>
            </table>
            <div class="stub_total_amount">Check Amount:
                <t t-esc="page['amount']"/>
            </div>
        </div>
    </template>

</odoo>
