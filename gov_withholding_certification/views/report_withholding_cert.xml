<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="l10n_do_report_withholding_document_inherited"
              inherit_id="l10n_do_withholding_certification.l10n_do_report_withholding_document">
        <xpath expr="//td[@name='b_amount']/span" position="before">
            <span t-esc="o.company_id.currency_id.symbol"/>
        </xpath>
        <xpath expr="//td[@name='b_tax_amount']/span" position="before">
            <span t-esc="o.company_id.currency_id.symbol"/>
        </xpath>
        <xpath expr="//td[@name='b_total']/span" position="before">
            <span t-esc="o.company_id.currency_id.symbol"/>
        </xpath>
        <xpath expr="//th[@name='h_date']" position="before">
            <th t-if="any(True for invoice in data['invoices_data'] if invoice['release_number'] or invoice['check_number'])">
                <span>Libramiento/Cheque</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='b_date']" position="before">
            <td t-if="invoice['release_number']" class="text-left">
                <span t-esc="invoice['release_number']"/>
            </td>
            <td t-if="invoice['check_number']" class="text-left">
                <span t-esc="invoice['check_number']"/>
            </td>
        </xpath>
        <xpath expr="//th[@name='f_totals']" position="before">
            <th t-if="any(True for invoice in data['invoices_data'] if invoice['release_number'] or invoice['check_number'])"></th>
        </xpath>
    </template>

</odoo>
