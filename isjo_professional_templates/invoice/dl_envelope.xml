<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
        <template id="INVOICE_0_document" name="DL Envelope Template">
            <!-- Multicompany -->
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"></t>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"></t>
            </t>
            <div class="header" t-attf-style="color:{{style.text_color}} !important;font-size:{{int(style.header_font)}}px !important;font-family:{{style.font_family}} !important;" >
                <div class="row mb-2" t-if="style.header">
                    <div class="col-5">
                        <div class="row">
                            <!-- Columna izquierda con logos -->
                            <div class="col-5 float-left" style="padding-left:0mm;">
                                <!-- Logo del estilo si existe -->
                                <div t-if="style.logo">
                                    <img t-att-src="image_data_uri(style.logo)" alt="Logo" style="max-height: 100px;"/>
                                </div>
                                <!-- Logo de la compañía si no hay estilo -->
                                <div t-if="not style.logo and company.logo">
                                    <img t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-height: 100px;"/>
                                </div>
                            </div>
                            
                            <!-- Columna derecha con información de la empresa y redes sociales -->
                            <div class="col-7 float-left">
                                <!-- Información de la empresa (similar al report_footer) -->
                                <div t-if="not company.report_footer" 
                                     t-attf-style="background-color:{{style.theme_color}}; color:{{style.theme_txt_color}}; padding:0.6mm 4mm; margin-bottom:5px;">
                                    <span t-if="company.name" t-field="company.name"/><br t-if="company.name"/>
                                    <span t-if="company.street" t-field="company.street"/><br t-if="company.street"/>
                                    <span t-if="company.company_registry">RNC: <span t-field="company.company_registry"/></span>
                                    <span t-if="company.email" class="fa-solid fa-envelope"/>&#160;<span t-field="company.email"/>
                                </div>
                                
                                <!-- Redes sociales -->
                                <div t-if="company.twitter or company.facebook or company.youtube" 
                                     t-attf-style="background-color:{{style.theme_color}}; color:{{style.theme_txt_color}}; padding:0.6mm 4mm;">
                                    <span t-if="company.twitter" class="fa fa-twitter-square"/>&#160;<span t-field="company.twitter"/>
                                    <span t-if="company.facebook" style="padding-left:3.45mm;" class="fa fa-facebook-square"/>&#160;<span t-field="company.facebook"/>
                                    <span t-if="company.youtube" style="padding-left:3.45mm;" class="fa fa-youtube-square"/>&#160;<span t-field="company.youtube"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--CODIGO LOGO ANTERIOR mb8 style="text-align: right;padding-bottom:0.6mm;padding-right:0mm;"-->
                    <!--<div class="col-7">
                        <div t-if="style.logo">
                            <img t-if="style.logo" t-att-src="image_data_uri(style.logo)" alt="Logo"/>
                        </div>
                        <div t-if="not style.logo">
                            <img  t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                        </div>
                        <div class="d-inline-block px-1" t-if="company.twitter or company.facebook or company.youtube" t-attf-style="background-color:{{style.theme_color}};color:{{style.theme_txt_color}};">
                            <span t-if="company.twitter" style="padding-left:0mm;" class="fa fa-twitter-square "/>&#160;<span t-field="company.twitter"/>
                            <span t-if="company.facebook" style="padding-left:3.45mm;" class="fa fa-facebook-square "/>&#160;<span t-field="company.facebook"/>
                            <span t-if="company.youtube" style="padding-left:3.45mm;" class="fa fa-youtube-square "/>&#160;<span t-field="company.youtube" />
                        </div>
                    </div>-->
                    <!--<div class="col-5 d-flex justify-content-end">-->
                    <div class="col-7 float-right">
                        <!-- Código Viejo -->
                        <t t-if="o.move_type == 'out_invoice' and o.state == 'draft'">
                            <h4><strong>FACTURA BORRADOR</strong></h4>
                        </t>
                        <t t-if="o.move_type == 'out_invoice' and o.state in ('proforma', 'proforma2')">
                            <h4><strong>FACTURA PROFORMA</strong></h4>
                        </t>
                        
                        <!-- Título de la factura para facturas emitidas -->
                        <t t-if="o.move_type == 'out_invoice' and o.state in ('posted','ready_to_post')">
                            <div style="width: 100%; text-align: right;">
                                <!-- Título fiscal grande (igual al documento ISJO) -->
                                <t t-if="'fiscal_type_id' in o._fields and o.fiscal_type_id">
                                    <t t-set="fiscal_name" t-value="o.fiscal_type_id.name"/>
                                    <h3 style="margin: 0 0 2px 0; font-weight: bold; text-transform: uppercase; line-height: 1.2; text-align: right;">
                                        <t t-if="'Factura' in fiscal_name">
                                            <t t-esc="fiscal_name.upper()"/>
                                        </t>
                                        <t t-else="">
                                            FACTURA DE <t t-esc="fiscal_name.upper()"/>
                                        </t>
                                    </h3>
                                </t>
                                <t t-else="">
                                    <h3 style="margin: 0 0 2px 0; font-weight: bold; text-align: right;">FACTURA</h3>
                                </t>

                                <!-- Línea separadora -->
                                <hr style="margin: 4px 0; border-top: 1px solid black;"/>

                                <!-- NCF alineado a la derecha -->
                                <div style="margin-bottom: 2px; text-align: right;" t-if="o.name or o.ref">
                                    <b style="font:14px lucida-console,sans-serif !important;">NCF :</b>
                                    <t t-if="o.ref">
                                        <span style="font:14px lucida-console,sans-serif !important;" t-field="o.ref"/>
                                    </t>
                                    <t t-else="">
                                        <span style="font:14px lucida-console,sans-serif !important;" t-field="o.name"/>
                                    </t>
                                </div>

                                <!-- Valida Hasta alineado a la derecha -->
                                <div style="text-align: right;" t-if="o.fiscal_sequence_expiration">
                                    <span style="font:14px lucida-console,sans-serif !important; font-weight: bold;">Valida Hasta :</span>
                                    <span style="font:14px lucida-console,sans-serif !important;" t-field="o.fiscal_sequence_expiration" t-options='{"format": "dd/MM/yyyy"}'/>
                                </div>
                            </div>
                        </t>

                        <!-- Facturas de proveedor -->
                        <t t-if="o.move_type == 'in_invoice'">
                            <h4><strong>FACTURAS PROVEEDOR</strong></h4>
                            <t t-if="o.name or o.ref">
                                <hr style="margin-bottom: 2px; border-top: 1px solid lightgray;"/>
                                <div style="text-align: left;">
                                    <b style="font:14px lucida-console,sans-serif !important;">NCF :</b>
                                    <t t-if="o.ref">
                                        <span style="font:14px lucida-console,sans-serif !important;" t-field="o.ref"/>
                                    </t>
                                    <t t-else="">
                                        <span style="font:14px lucida-console,sans-serif !important;" t-field="o.name"/>
                                    </t>
                                    <!-- Válida Hasta: solo si hay fecha de expiración fiscal -->
                                    <t t-if="o.fiscal_sequence_expiration">
                                        <br/>
                                        <b style="font:14px lucida-console,sans-serif !important;">Valida Hasta :</b>
                                        <span style="font:14px lucida-console,sans-serif !important;" t-field="o.fiscal_sequence_expiration" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </t>
                                </div>
                            </t>
                        </t>
                        
                        <!-- Notas de crédito -->
                        <t t-if="o.move_type == 'out_refund'">
                            <h4><strong>NOTA DE CREDITO</strong></h4>
                            <t t-if="o.name or o.ref">
                                <hr style="margin-bottom: 2px; border-top: 1px solid lightgray;"/>
                                <div style="text-align: left;">
                                    <b style="font:14px lucida-console,sans-serif !important;">NCF :</b>
                                    <t t-if="o.ref">
                                        <span style="font:14px lucida-console,sans-serif !important;" t-field="o.ref"/>
                                    </t>
                                    <t t-else="">
                                        <span style="font:14px lucida-console,sans-serif !important;" t-field="o.name"/>
                                    </t>
                                </div>
                                <br/>
                                <b style="font:14px lucida-console,sans-serif !important;">NCF MODIFICADO :</b> 
                                <span style="font:14px lucida-console,sans-serif !important;" t-field="o.origin_out"/>
                            </t>
                        </t>
                    </div>
                </div>
            </div> <!--end of Header-->
            <!-- START OF PAGE -->
            <div class="article page" t-attf-data-oe-model="account.move" t-attf-data-oe-id="{{o.id}}" t-attf-style="color:{{style.text_color}} !important;font-size:{{int(style.body_font)}}px !important;font-family:{{style.font_family}} !important;">
                <div class="col-12" t-attf-style="white-space:pre-line;color:#{style.wm_color};left:#{style.leftpadding}mm; top:#{style.toppadding}mm;font-size:#{style.fontsize}px; opacity:#{style.opacity};z-index:-99; -webkit-transform:rotate(-#{style.rotate}deg);position:fixed;"><t t-esc="style.wm_eval(o, time, user, res_company)"/></div>

                <div class="row mb-2">
                    <div class="col-5">
                        <div t-if="o.partner_id" t-attf-style="color:{{style.cust_color}};font-size:{{int(style.body_font)+2}}px;">
                            <span t-field="o.partner_id.display_name"/>
                        </div>
                        <div t-field="o.partner_id" t-options='{"widget": "contact", "fields":["address","phone"],"no_marker": true}'/>
                        <div t-field="o.partner_id" t-options='{"widget": "contact", "fields":["email"],"no_marker": true}'/>
                        <div t-field="o.partner_id" t-options='{"widget": "contact", "fields":["website"],"no_marker": true}'/>
                        <div t-if="o.partner_id.vat">VAT: <span t-field="o.partner_id.vat"/></div>
                    </div>
                    <div class="col-7" t-attf-style="background-color:{{style.theme_color}}; color:{{style.theme_txt_color}};">
                        <h4 id="invoice_title">
                            <!--<span t-if="o.state == 'draft'">Draft</span>
                            <span t-if="o.state == 'cancel'">Cancelled</span>
                            <span t-if="o.move_type == 'out_invoice'">Invoice</span>
                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>-->
                            # - <span t-field="o.name" t-if="o.state not in ['cancel', 'draft']"/>
                        </h4>
                        <div class="d-flex d-inline-block px-2">
                            <div t-if="o.invoice_date" class="px-2">
                                <strong>Fecha Factura:</strong>
                                <p t-field="o.invoice_date"/>
                            </div>
                            <div t-if="o.invoice_date_due" class="px-2">
                                <strong>Fecha Vencimiento:</strong>
                                <p t-field="o.invoice_date_due"/>
                            </div>
                            <div t-if="o.invoice_origin" class="px-2">
                                <strong>Origen:</strong>
                                <p t-field="o.invoice_origin"/>
                            </div>
                            <div t-if="o.partner_id.ref" class="px-2">
                                <strong>Referencia Cliente:</strong>
                                <p t-field="o.partner_id.ref"/>
                            </div>
                            <div t-if="o.ref" class="px-2">
                                <strong>Referencia:</strong>
                                <p t-field="o.ref"/>
                            </div>
                        </div>
                    </div>
                </div> <!--end of wrapper2-->
                <!-- DATA-->
                <t t-call="isjo_professional_templates.invoice_lines"/>
                    <!--/DATA-->
            </div><!--End of PAGE-->
            <!--FOOTER -->
            <div class="footer" t-attf-style="font-size:{{style.footer_font}}px !important;font-family:{{style.font_family}} !important;">
                <t t-call="isjo_professional_templates.company_footer"/>
            </div>
            <!--/FOOTER-->
        </template>

    
</odoo>
