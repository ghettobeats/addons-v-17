<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
        <template id="INVOICE_14_document" name="Ascend Template">
            <!-- Multicompany -->
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"></t>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"></t>
            </t>
            <div class="header">
                <div t-if="style.header" class="row mb-2" t-attf-style="color:{{style.text_color}} !important;font-size:{{int(style.header_font)}}px !important;font-family:{{style.font_family}} !important; border-bottom:1px solid {{style.theme_color}};">
                    <!-- Columna izquierda: Logo encima + nombre y RNC debajo -->
                    <div class="col-5" style="padding-bottom: 6px;">
                        <div style="margin-bottom: 4px;">
                            <img t-if="style.logo" t-att-src="image_data_uri(style.logo)" alt="Logo" style="max-height:80px;"/>
                            <img t-if="not style.logo and company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-height:80px;"/>
                        </div>
                        <div t-attf-style="font-size:{{int(style.header_font)}}px !important;">
                            <strong><span t-field="company.display_name"/></strong><br/>
                            <t t-if="company.company_registry">RNC: <span t-field="company.company_registry"/></t>
                        </div>
                    </div>
                    <!-- Columna derecha: Bloque fiscal -->
                    <div class="col-7" style="padding-top: 4px; text-align: right;">
                        <t t-if="o.move_type == 'out_invoice' and o.state in ('posted','ready_to_post')">
                            <t t-if="'fiscal_type_id' in o._fields and o.fiscal_type_id">
                                <t t-set="fiscal_name" t-value="o.fiscal_type_id.name"/>
                                <h3 style="margin: 0 0 2px 0; font-weight: bold; text-transform: uppercase; line-height: 1.2; text-align: right;">
                                    <t t-if="'Factura' in fiscal_name"><t t-esc="fiscal_name.upper()"/></t>
                                    <t t-else="">FACTURA DE <t t-esc="fiscal_name.upper()"/></t>
                                </h3>
                            </t>
                            <t t-else="">
                                <h3 style="margin: 0 0 2px 0; font-weight: bold; text-align: right;">FACTURA</h3>
                            </t>
                            <hr style="margin: 4px 0; border-top: 1px solid black;"/>
                            <div style="margin-bottom: 2px; text-align: right;" t-if="o.name or o.ref">
                                <b style="font:14px lucida-console,sans-serif !important;">NCF :</b>
                                <t t-if="o.ref">
                                    <span style="font:14px lucida-console,sans-serif !important;" t-field="o.ref"/>
                                </t>
                                <t t-else="">
                                    <span style="font:14px lucida-console,sans-serif !important;" t-field="o.name"/>
                                </t>
                            </div>
                            <div style="text-align: right;" t-if="o.fiscal_sequence_expiration">
                                <span style="font:14px lucida-console,sans-serif !important; font-weight: bold;">Valida Hasta :</span>
                                <span style="font:14px lucida-console,sans-serif !important;" t-field="o.fiscal_sequence_expiration" t-options='{"format": "dd/MM/yyyy"}'/>
                            </div>
                        </t>
                        <t t-if="o.move_type == 'out_refund'">
                            <h3 style="margin: 0 0 2px 0; font-weight: bold; text-align: right;">NOTA DE CRÉDITO</h3>
                            <hr style="margin: 4px 0; border-top: 1px solid black;"/>
                            <div style="text-align: right;" t-if="o.name or o.ref">
                                <b style="font:14px lucida-console,sans-serif !important;">NCF :</b>
                                <t t-if="o.ref"><span style="font:14px lucida-console,sans-serif !important;" t-field="o.ref"/></t>
                                <t t-else=""><span style="font:14px lucida-console,sans-serif !important;" t-field="o.name"/></t>
                            </div>
                        </t>
                        <t t-if="o.move_type == 'in_invoice'">
                            <h3 style="margin: 0 0 2px 0; font-weight: bold; text-align: right;">FACTURA PROVEEDOR</h3>
                        </t>
                    </div>
                </div>
            </div> <!--end of Header-->
            <!-- START OF PAGE -->
            <div class="article page" t-attf-data-oe-model="account.move" t-attf-data-oe-id="{{o.id}}" t-attf-style="color:{{style.text_color}} !important;font-size:{{int(style.body_font)}}px !important;font-family:{{style.font_family}} !important;">
                <div class="col-12" t-attf-style="white-space:pre-line;color:#{style.wm_color};left:#{style.leftpadding}mm; top:#{style.toppadding}mm;font-size:#{style.fontsize}px; opacity:#{style.opacity};z-index:-99; -webkit-transform:rotate(-#{style.rotate}deg);position:fixed;"><t t-esc="style.wm_eval(o, time, user, res_company)"/></div>

                <!-- Cliente + Fechas -->
                <div class="row mb-2 pb-2" t-attf-style="border-bottom:1px solid {{style.theme_color}};">
                    <div class="col-6" style="font-size:14px;">
                        <div t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id"
                             t-field="o.partner_shipping_id" style="margin-bottom:0px;"
                             t-options='{"widget": "contact", "fields":["name", "address"],"no_marker": true}'/>
                        <div t-if="not o.partner_shipping_id or o.partner_shipping_id == o.partner_id"
                             t-field="o.partner_id" style="margin-bottom:0px;"
                             t-options='{"widget": "contact", "fields":["name", "address"],"no_marker": true}'/>
                        <div t-if="o.partner_id.vat">RNC/Cédula: <span t-field="o.partner_id.vat"/></div>
                    </div>
                    <div class="col-6" style="font-size:14px;">
                        <div t-if="o.invoice_date">
                            <t t-if="o.move_type == 'out_invoice'"><strong>Fecha Factura: </strong></t>
                            <t t-elif="o.move_type == 'out_refund'"><strong>Fecha Nota Crédito: </strong></t>
                            <t t-else=""><strong>Fecha: </strong></t>
                            <span t-field="o.invoice_date"/>
                        </div>
                        <div t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                            <strong>Fecha Vencimiento: </strong>
                            <span t-field="o.invoice_date_due"/>
                        </div>
                        <div t-if="o.invoice_origin">
                            <strong>Origen: </strong>
                            <span t-field="o.invoice_origin"/>
                        </div>
                        <div t-if="o.ref">
                            <strong>Referencia: </strong>
                            <span t-field="o.ref"/>
                        </div>
                        <div t-if="o.sudo().user_id">
                            <strong>Vendedor: </strong>
                            <span t-field="o.sudo().user_id"/>
                        </div>
                    </div>
                </div>
                <!-- Título documento -->
                <div class="row mb-2">
                    <div class="mt-2">
                        <h3 t-attf-style="color:{{style.theme_color}};">
                            <span t-if="o.state == 'draft'">Borrador </span>
                            <span t-if="o.state == 'cancel'">Cancelado </span>
                            <span t-if="o.move_type == 'out_invoice'">Factura </span>
                            <span t-if="o.move_type == 'out_refund'">Nota de Crédito </span>
                            <span t-if="o.move_type == 'in_refund'">Nota Crédito Proveedor </span>
                            <span t-if="o.move_type == 'in_invoice'">Factura Proveedor </span>
                            <span t-field="o.name" t-if="o.state not in ['draft', 'cancel']"/>
                        </h3>
                    </div>
                </div>
                <!-- DATA-->
                <t t-call="isjo_professional_templates.invoice_lines"/>
                    <!--/DATA-->
            </div><!--End of PAGE-->
            <!--FOOTER -->
            <div class="footer" t-attf-style="font-size:{{style.footer_font}}px !important;font-family:{{style.font_family}} !important;">
                <t t-call="isjo_professional_templates.company_footer"/>
            </div>
            <!--/FOOTER-->
        </template>

    
</odoo>
