<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
        <template id="INVOICE_2_document" name="Classic Template">
            <!-- Multicompany -->
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"></t>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"></t>
            </t>
            <div class="header" t-attf-style="color:{{style.text_color}} !important;font-size:{{int(style.header_font)}}px !important;font-family:{{style.font_family}} !important;">
                <div class="row p-0 mb-1" t-if="style.header" style="align-items: flex-start; border-bottom: 1px solid #ddd;">
                    <!-- Izquierda: logo (arriba) + nombre empresa + RNC -->
                    <div class="col-4 px-1" style="padding-bottom: 4px;">
                        <div style="margin-bottom: 3px;">
                            <img t-if="style.logo" t-att-src="image_data_uri(style.logo)" alt="Logo" style="max-height:55px; max-width:100%;"/>
                            <img t-if="not style.logo and company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-height:55px; max-width:100%;"/>
                        </div>
                        <div t-attf-style="font-size:{{int(style.header_font)}}px !important;">
                            <strong><span t-field="company.display_name"/></strong><br/>
                            <t t-if="company.company_registry">RNC: <span t-field="company.company_registry"/></t>
                        </div>
                    </div>
                    <!-- Derecha: bloque fiscal -->
                    <div class="col-8 px-1" style="text-align: right; padding-top: 2px;">
                        <t t-if="o.move_type == 'out_invoice' and o.state in ('posted','ready_to_post')">
                            <t t-if="'fiscal_type_id' in o._fields and o.fiscal_type_id">
                                <t t-set="fiscal_name" t-value="o.fiscal_type_id.name"/>
                                <h3 style="margin: 0 0 2px 0; font-weight: bold; text-transform: uppercase; line-height: 1.2;">
                                    <t t-if="'Factura' in fiscal_name"><t t-esc="fiscal_name.upper()"/></t>
                                    <t t-else="">FACTURA DE <t t-esc="fiscal_name.upper()"/></t>
                                </h3>
                            </t>
                            <t t-else="">
                                <h3 style="margin: 0 0 2px 0; font-weight: bold;">FACTURA</h3>
                            </t>
                            <hr style="margin: 3px 0; border-top: 1px solid black;"/>
                            <div style="margin-bottom: 2px;" t-if="o.name or o.ref">
                                <b style="font:14px lucida-console,sans-serif !important;">NCF :</b>
                                <t t-if="o.ref"><span style="font:14px lucida-console,sans-serif !important;" t-field="o.ref"/></t>
                                <t t-else=""><span style="font:14px lucida-console,sans-serif !important;" t-field="o.name"/></t>
                            </div>
                            <div t-if="o.fiscal_sequence_expiration">
                                <span style="font:14px lucida-console,sans-serif !important; font-weight: bold;">Valida Hasta :</span>
                                <span style="font:14px lucida-console,sans-serif !important;" t-field="o.fiscal_sequence_expiration" t-options='{"format": "dd/MM/yyyy"}'/>
                            </div>
                        </t>
                        <t t-if="o.move_type == 'out_refund'">
                            <h3 style="margin: 0 0 2px 0; font-weight: bold;">NOTA DE CRÉDITO</h3>
                            <hr style="margin: 3px 0; border-top: 1px solid black;"/>
                            <div t-if="o.name or o.ref">
                                <b style="font:14px lucida-console,sans-serif !important;">NCF :</b>
                                <t t-if="o.ref"><span style="font:14px lucida-console,sans-serif !important;" t-field="o.ref"/></t>
                                <t t-else=""><span style="font:14px lucida-console,sans-serif !important;" t-field="o.name"/></t>
                            </div>
                        </t>
                        <t t-if="o.move_type == 'in_invoice'">
                            <h3 style="margin: 0 0 2px 0; font-weight: bold;">FACTURA PROVEEDOR</h3>
                        </t>
                    </div>
                </div>
            </div> <!--end of Header-->
            <!-- START OF PAGE -->
            <div class="article page" t-attf-data-oe-model="account.move" t-attf-data-oe-id="{{o.id}}" t-attf-style="color:{{style.text_color}} !important;font-size:{{int(style.body_font)}}px !important;font-family:{{style.font_family}} !important;">
                <div class="col-12" t-attf-style="white-space:pre-line;color:#{style.wm_color};left:#{style.leftpadding}mm; top:#{style.toppadding}mm;font-size:#{style.fontsize}px; opacity:#{style.opacity};z-index:-99; -webkit-transform:rotate(-#{style.rotate}deg);position:fixed;"><t t-esc="style.wm_eval(o, time, user, res_company)"/></div>

                <div class="p-1 mb-2" t-attf-style="color:{{style.theme_txt_color}} !important;background-color:{{style.theme_color}} !important;">
                    <div>
                        <h3>
                            <span t-if="o.state == 'draft'">Draft</span>
                            <span t-if="o.state == 'cancel'">Cancelled</span>
                            <span t-if="o.move_type == 'out_invoice'">Invoice</span>
                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                            <span t-field="o.name" t-if="o.state not in ['draft', 'cancel']"/>
                        </h3>
                    </div>
                    <!-- <div class="col-4 d-flex justify-content-end"> -->
                        <div class="row row-cols-5">
                            <div class="col" t-if="o.invoice_date">
                                <t t-if="o.move_type == 'out_invoice'"><strong>Fecha Factura:</strong></t>
                                <t t-elif="o.move_type == 'out_refund'"><strong>Fecha N. Crédito:</strong></t>
                                <t t-else=""><strong>Fecha:</strong></t>
                                <span t-field="o.invoice_date"/>
                            </div>
                            <div class="col" t-if="o.invoice_date_due">
                                <strong>Vencimiento:</strong>
                                <span t-field="o.invoice_date_due"/>
                            </div>
                            <div class="col" t-if="o.invoice_origin">
                                <strong>Origen:</strong>
                                <span t-field="o.invoice_origin"/>
                            </div>
                            <div class="col" t-if="o.partner_id.ref">
                                <strong>Cód. Cliente:</strong>
                                <span t-field="o.partner_id.ref"/>
                            </div>
                            <div class="col" t-if="o.ref">
                                <strong>Referencia:</strong>
                                <span t-field="o.ref"/>
                            </div>
                        </div>
                    </div>

                    <div class="row row-cols-2 p-1 mb-0"><!--start of wrapper -->
                        <div class="col" t-attf-style="font-size:{{int(style.body_font)+6}}px; font-weight:bold;">
                            <span t-if="o.partner_id">
                                <i class="fa fa-user "/> Invoicing Address</span>
                            <span t-if="o.partner_shipping_id and o.partner_shipping_id == o.partner_id">&#160; &amp;&#160; <i class="fa fa-truck "/> Delivery Address</span>

                    </div>
                    <div  class="col d-flex justify-content-end text-nowrap">
                        <span t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id" t-attf-style="font-size:{{int(style.body_font)+6}}px; font-weight:bold;"><i class="fa fa-truck "/> Delivery Address</span>
                    </div>
                </div>
                <div class="row row-cols-2 p-1 mb-2"><!--start of wrapper -->
                    <div class="col">
                        <div t-if="o.partner_id" t-attf-style="color:{{style.cust_color}};font-size:{{int(style.body_font)+6}}px;font-weight:500;">
                            <t t-if="o.partner_id.parent_id">
                                <span t-field="o.partner_id.parent_id"/>, <span t-if="o.partner_id.title" t-field="o.partner_id.title"/> <span t-field="o.partner_id.name"/>
                            </t>
                            <t t-if="not o.partner_id.parent_id">
                                <span t-if="o.partner_id.title" t-field="o.partner_id.title"/> <span t-field="o.partner_id"/>
                            </t>
                        </div>
                        <div t-field="o.partner_id"  t-options='{"widget": "contact", "fields":["address","phone"],"no_marker": false}'/>
                        <div t-field="o.partner_id"  t-options='{"widget": "contact", "fields":["email"],"no_marker": false}'/>
                        <div t-field="o.partner_id"  t-options='{"widget": "contact", "fields":["website"],"no_marker": false}'/>
                        <div t-if="o.partner_id.vat">VAT: <span t-field="o.partner_id.vat"/></div>
                    </div>
                    <div class="col d-flex justify-content-end">
                        <div t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id" t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields":["name", "address","phone"],"no_marker": false}'/>
                        <div t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id" t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields":["email"],"no_marker": false}'/>
                        <div t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id" t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields":["website"],"no_marker": false}'/>
                        <div t-if="o.partner_id.vat">VAT: <span t-field="o.partner_id.vat"/></div>
                    </div>
                </div> <!--end of wrapper2-->
                <!-- DATA-->
                <t t-call="isjo_professional_templates.invoice_lines"/>
                    <!--/DATA-->
            </div><!--End of PAGE-->
            <!--FOOTER -->
            <div class="footer" t-attf-style="background-color:transparent !important;font-size:{{style.footer_font}}px !important;font-family:{{style.font_family}} !important;">
                <t t-call="isjo_professional_templates.company_footer"/>
            </div>
            <!--/FOOTER-->

        </template>
    
</odoo>
