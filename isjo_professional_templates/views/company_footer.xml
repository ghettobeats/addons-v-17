<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
        <template id="company_footer" name="page Footer">
            <t t-if="style.footer">
                <t t-set="company" t-value="company.sudo()"/>
                <t t-set="footer_style" t-value="'text-align:left;display:inline-block;width:auto;max-width:100%'"></t>
                <div class="col-12 text-center float-left" t-attf-style="background-color:transparent !important; color:{{style.text_color}};border-top: 1px solid {{style.text_color}};padding-top:5px;padding-left:0px; padding-right:0px;">
                    <t t-if="not company.report_footer">
                        <div class="text-center">
                            <ul class="list-inline mb4" style="font-size: 12px; font-style: italic;">
                                <i t-if="company.street">
                                    <i class="fa-solid fa-road"></i>
                                    Dirección:
                                    <span t-field="company.street"/>
                                </i>&#160;
                                <i t-if="company.street2">
                                    <span t-field="company.street2"/>
                                </i>&#160;
                                <i t-if="company.city">
                                    <span t-field="company.city"/>
                                </i>&#160;
                                <i t-if="company.state_id">
                                    <span t-field="company.state_id.name"/>
                                </i>
                                <i t-if="company.phone">
                                    <i class="fa fa-phone"/>
                                    Phone:
                                    <span t-field="company.phone"/>
                                </i>
                                <i t-if="company.email">
                                    <i class="fa fa-envelope"/>
                                    Email:
                                    <span t-field="company.email"/>
                                </i>
                                <i t-if="company.website">
                                    <i class="fa fa-globe"/>
                                    Web:
                                    <span t-field="company.website"/>
                                </i>
                                <i t-if="company.vat">RNC:
                                    <span t-field="company.vat"/>
                                </i>
                            </ul>
                            
                            <!-- Footer Logo -->
                            <div t-if="style.show_footer_logo" t-attf-style="#{footer_style}"> <!--Footer Logo (optional) -->
                                <ul style="padding: 0px;">
                                    <div>
                                        <img t-if="style.footer_logo" t-att-src="image_data_uri(style.footer_logo)" class="float-right" alt="Footer Logo" style="max-width:100px;"/>
                                        <img t-if="not style.footer_logo and style.logo" t-att-src="image_data_uri(style.logo)" class="float-right" alt="Footer Logo" style="max-width:100px;"/>
                                        <img t-if="not style.footer_logo and not style.logo and company.logo" t-att-src="image_data_uri(company.logo)" class="float-right" alt="Footer Logo" style="max-width:100px;"/>
                                    </div>
                                </ul>
                            </div>
                
                            <!-- Numeración de página -->
                            <div class="text-center text-muted" style="font-size: 12px; font-style: italic;">
                                Page:
                                <span class="page"/>
                                /
                                <span class="topage"/>
                                -
                                <span class="text-right"
                                      t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>
                            </div>
                        </div>
                    </t>
                    
                    <!-- Report footer personalizado -->
                    <div t-if="company.report_footer" class="text-center" style="font-size: 12px; font-style: italic;">
                        <span t-field="company.report_footer"/>
                    </div>
                </div>
                <!--<div class="col-12 text-center float-left" t-attf-style="background-color:transparent !important; color:{{style.text_color}};border-top: 1px solid {{style.text_color}};padding-top:5px;padding-left:0px; padding-right:0px;">
                    &lt;!&ndash; <t t-if="not company.report_footer"> &ndash;&gt;
                        <div t-attf-style="#{footer_style}" t-attf-class="#{style.show_footer_logo and 'mr16' or 'mr32'}"> &lt;!&ndash;Address &ndash;&gt;
                            <ul style="padding: 0px;">
                                <div t-if="company.name"><span t-field="company.name"/></div>
                                <div t-if="company.street"><i class="fa fa-map-marker"/> <span t-field="company.street"/></div>
                                <div t-if="company.street2" class="ml8"><span t-field="company.street2"/></div>
                                <div t-if="company.city or company.state_id or company.zip" class="ml8"><span t-field="company.city"/> <span t-field="company.state_id"/> <span t-field="company.zip"/></div>
                                <div t-if="company.country_id" class="ml8"><span t-field="company.country_id"/></div>
                            </ul>
                        </div>
                        <div t-attf-style="#{footer_style}" t-attf-class="#{style.show_footer_logo and 'mr16' or 'mr32'}">&lt;!&ndash;Contacts &ndash;&gt;
                            <ul style="padding: 0px;">
                                <div t-if="company.phone"><i class="fa fa-phone-square"/> <span t-field="company.phone"/></div>
                                <div t-if="company.website"><i class="fa fa-globe"/> <span t-field="company.website"/></div>
                                <div t-if="company.email"><i class="fa fa-envelope"/> <span t-field="company.email"/></div>
                                <div t-if="company.facebook or company.twitter or company.youtube">
                                    <i class="fa fa-facebook-square" t-if="company.facebook" /> <span t-if="company.facebook" t-field="company.facebook"/>
                                    <i class="fa fa-twitter-square" t-if="company.twitter" /> <span t-if="company.twitter" t-field="company.twitter"/>
                                    <i class="fa fa-youtube-square" t-if="company.youtube" /> <span t-if="company.youtube" t-field="company.youtube"/>
                                </div>
                            </ul>
                        </div>
                        <div t-attf-style="#{footer_style}" class="mr16"> &lt;!&ndash;Bank Details optional &ndash;&gt;
                            <ul style="padding: 0px;">
                                <t t-foreach="company.bank_journal_ids" t-as="journal">
                                    &lt;!&ndash; <t t-if="journal.display_on_footer"> &ndash;&gt;
                                        <t t-set="bank_acc" t-value="journal.bank_account_id"/>
                                        <div t-if="bank_acc">
                                            <i class="fa fa-building"/>
                                            <span t-field="bank_acc.bank_name"/><t t-if="bank_acc.bank_bic"> (<span t-field="bank_acc.bank_bic"/>)</t>: <span t-field="bank_acc.acc_number"/>
                                        </div>
                                    &lt;!&ndash; </t> &ndash;&gt;
                                </t>
                                <div t-if="company.vat"><i class="fa fa-certificate" aria-hidden="true"/> VAT: <span t-field="company.vat"/></div>
                            </ul>
                        </div>
                        <div t-if="style.show_footer_logo" t-attf-style="#{footer_style}"> &lt;!&ndash;Footer Logo (optional) &ndash;&gt;
                            <ul style="padding: 0px;">
                                <div>
                                    <img t-if="style.footer_logo" t-att-src="image_data_uri(style.footer_logo)" class="float-right" alt="Footer Logo" style="max-width:100px;"/>
                                    <img t-if="not style.footer_logo and style.logo" t-att-src="image_data_uri(style.logo)" class="float-right" alt="Footer Logo" style="max-width:100px;"/>
                                    &lt;!&ndash;<img t-if="not style.footer_logo and not style.logo and company.logo" t-att-src="image_data_uri(company.logo)" class="float-right" alt="Footer Logo" style="max-width:100px;"/>&ndash;&gt;
                                </div>
                            </ul>
                        </div>
                    &lt;!&ndash; </t> &ndash;&gt;
                </div>-->
            </t>
            <div t-if="company.report_footer !='' and not style.footer" class="text-center"><span t-field="company.report_footer"/></div>
            <!--<div class="col-12 text-center text-muted float-left">Page: <span class="page"/> / <span class="topage"/></div>-->
        </template>
    
</odoo>
