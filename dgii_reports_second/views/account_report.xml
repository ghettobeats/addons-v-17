<odoo>
    <data>
        <!-- QWeb Reports -->
        <record id="account_payment_tax_cert" model="ir.actions.report">
            <field name="name">Certificado de retenciones</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">dgii_reports_second.tax_cert_report_payment_receipt</field>
            <field name="report_file">dgii_reports_second.tax_cert_report_payment_receipt</field>
            <field name="print_report_name">((object.name or '').replace('/','_')+'-'+(object.partner_id.name or '').replace('/','_')+'-Certificado de retenciones-'
 +((str(object.date) or 'latest').replace('/','_')))</field>
            <field name="binding_model_id" ref="account.model_account_payment"/>
            <field name="binding_type">report</field
            >
            <field name="groups_id" eval="[(4, ref('account.group_account_invoice')),
 (4, ref('account.group_account_readonly'))]"/>
        </record>

