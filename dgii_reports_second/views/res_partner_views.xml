<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form_inherited2" model="ir.ui.view">
        <field name="name">view.partner.form.inherited2</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_type']" position="after">
                <br/><field name="related" widget="radio" class="oe_edit_only"
                            options="{'horizontal': true}"
                            attrs="{'invisible': [('country_id', '=', %(base.do)d)]}"/>
            </xpath>

            <xpath expr="//field[@name='email']" position="replace">
                <field name="is_company_related" invisible="1"/>
                <field name="email" widget="email" context="{'gravatar_image': True}" attrs="{'required': [('user_ids','!=', [])],
                'readonly': [('is_company_related','=', True)]}"/>
            </xpath>

        </field>
    </record>

</odoo>
