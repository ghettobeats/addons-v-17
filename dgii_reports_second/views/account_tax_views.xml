<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tipo de retencion ISR 606-->

    <record id="view_tax_form_inherited" model="ir.ui.view">
        <field name="name">account.view.tax.form.inherited</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[2]/group/group[1]" position="after">
                <group>
                    <field name="is_itbis" invisible="1"/>
                    <field name="is_isr" invisible="1"/>
                    <field name="is_tc_comision" attrs="{'invisible':[('type_tax_use', '!=', 'sale')]}"/>
                    <field name="is_tc_extra" attrs="{'invisible':[('type_tax_use', '!=', 'sale')]}"/>
                    <field name="isr_retention_type" attrs="{'invisible':['|','|',('is_tc_comision', '=', True), ('type_tax_use', '!=', 'purchase'),('is_isr', '!=', True)],
                    'required':[('type_tax_use', '=', 'purchase'),('is_isr', '=', True)]}"/>
                    <field name="sale_itbis_retention_type" attrs="{'invisible':['|','|',('is_tc_comision', '=', True), ('type_tax_use', '!=', 'sale'),('is_itbis', '!=', True)],
                    'required':[('type_tax_use', '=', 'sale'),('is_itbis', '=', True)]}"/>
                    <field name="purchase_itbis_retention_type" attrs="{'invisible':['|','|',('is_tc_comision', '=', True), ('type_tax_use', '!=', 'purchase'),('is_itbis', '!=', True)],
                    'required':[('type_tax_use', '=', 'purchase'),('is_itbis', '=', True)]}"/>
                    <field name="calculate_ret_itbis_basesubtotal" attrs="{'invisible':[('sale_itbis_retention_type', '!=', '01')]}"/>
                    <field name="is_import" attrs="{'invisible':['|',('is_tc_comision', '=', True), ('type_tax_use', '!=', 'purchase')]}"/>
                </group>
            </xpath>
        </field>
    </record>


</odoo>
