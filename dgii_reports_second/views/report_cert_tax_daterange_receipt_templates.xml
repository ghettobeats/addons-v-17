    <report id="action_print_tax_cert_daterange"
        model="create.withholding.tax.cert"
        report_type="qweb-pdf"
        menu="False"
        string="Certificado de retencion-Rango de fecha"
        name="dgii_reports.tax_cert_daterange_report_payment_receipt"
        file="dgii_reports.tax_cert_daterange_report_payment_receipt"

    />


</odoo>
