<odoo>
    <data>

        <record id="withholding_tax_cert_date_range" model="ir.ui.view">
            <field name="name">create.withholding.tax.cert.view</field>
            <field name="model">create.withholding.tax.cert</field>
            <field name="arch" type="xml">
                <form>
                    <group string="Datos generales" col="4">
                        <field name="partner_id"/>
                        <field name="company_id" readonly="1"/>
                        <field name="certificate_date"/>
                        <field name="currency_id"/>
                    </group>
                    <group string="Rango de fecha" col="4">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>

                    <footer>
                        <button name="action_pdf" type="object" string="Print PDF" class="oe_highlight"/>
                        <button string="Cancel" class="btn-default" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_withholding_tax_cert_date_range_wizard" model="ir.actions.act_window">
            <field name="name">Certificado de retencion: Rango de fecha</field>
            <field name="res_model">create.withholding.tax.cert</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="withholding_tax_cert_date_range"/>
            <field name="target">new</field>
        </record>

<!--        <record id="action_tax_cert_wizard" model="ir.actions.client">-->
<!--            <field name="name">Certificado de retencion: Rango de fecha</field>-->
<!--            <field name="res_model">create.withholding.tax.cert</field>-->
<!--            <field name="tag">tax.cert.wizard</field>-->
<!--        </record>-->


    <menuitem id="dgii_report_parent_menu_2" name="Tax reports"
              parent="account_dgii_menu"
              sequence="2"/>


    <menuitem id="dgii_account_action_tax_cert_wizard" sequence="31" action="action_withholding_tax_cert_date_range_wizard"
                  name="Certificado de retencion: Rango de fecha" parent="dgii_report_parent_menu_2" groups="account.group_account_user"/>



    </data>
</odoo>
