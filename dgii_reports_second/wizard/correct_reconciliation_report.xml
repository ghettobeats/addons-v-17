<odoo>
    <data>

        <record id="action_correct_reconciliation_report_view" model="ir.ui.view">
            <field name="name">correct.reconciliation.report.view</field>
            <field name="model">correct.reconciliation.report</field>
            <field name="arch" type="xml">
                <form>
                    <group col="4">
                        <field name="report_date" invisible="1"/>
                        <field name="company_id" readonly="1"/>
                        <field name="name" placeholder="MM/AAAA"/>
                        <field name="journal_id" options='{"no_open": True, "no_create": True}'/>
                    </group>
                    <footer>
                        <button name="action_pdf" type="object" string="Imprimir" class="oe_highlight"/>
                        <button string="Cancel" class="btn-default" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_correct_reconciliation_report" model="ir.actions.act_window">
            <field name="name">Reporte de conciliacion bancaria</field>
            <field name="res_model">correct.reconciliation.report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="action_correct_reconciliation_report_view"/>
            <field name="target">new</field>
        </record>


        <menuitem id="correct_reconciliation_report" sequence="101" action="action_correct_reconciliation_report"
                  name="Reporte de conciliacion bancaria" parent="account_bank_menu" groups="account.group_account_user"/>



    </data>
</odoo>
