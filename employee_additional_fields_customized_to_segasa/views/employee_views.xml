        <record id="view_employee_tree_inherit_identification_id" model="ir.ui.view">
            <field name="name">hr.employee.tree.inherit.identification</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <!-- Agregar la columna de cÃ©dula -->
                <field name="name" position="before">
