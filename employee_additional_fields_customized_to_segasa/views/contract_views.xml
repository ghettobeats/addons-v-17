<odoo>
      
        <record id="inherit_hr_contract_view_search" model="ir.ui.view">
            <field name="name">hr.contract.search.inherit</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_search"/>
            <field name="arch" type="xml">
                <!-- Ejemplo: Agregar un nuevo filtro -->
                <!--<filter string="New Filter" name="new_filter" domain="[('state', '=', 'new_state')]"/>-->
                
                <!-- Ejemplo: Modificar un filtro existente -->
                <xpath expr="//filter[@name='running']" position="attributes">
                    <attribute name="string">Contratos Activos</attribute>
                </xpath>
        
                <!-- Ejemplo: Eliminar un filtro -->
                <xpath expr="//filter[@name='not_running']" position="replace"/>
            </field>
        </record>

      
        <record id="action_hr_contract" model="ir.actions.act_window">
            <field name="name">Contracts</field>
            <field name="res_model">hr.contract</field>
            <field name="view_mode">tree,kanban,form,activity</field>
            <field name="domain">[('employee_id', '!=', False)]</field>
            <field name="context">
                {'search_default_group_by_state': 1, 
                 'default_name': employee_id and (str(employee_id) + " CT " + employee_name) or ""}
            </field>
            <field name="search_view_id" ref="employee_additional_fields_customized_to_segasa.inherit_hr_contract_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new contract
                </p>
            </field>
        </record>
      
        <record id="view_hr_contract_form_inherit_readonly" model="ir.ui.view">
            <field name="name">hr.contract.form.readonly.name</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
            <field name="arch" type="xml">
                <field name="name" position="attributes">
                    <attribute name="readonly">[('employee_id', '!=', False)]</attribute>
                </field>
                <field name="employee_id" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </field>
                <!-- Modificar la primera instancia de department_id -->
                <xpath expr="//field[@name='department_id' and @groups='!hr_contract.group_hr_contract_manager']" position="attributes">
                    <attribute name="readonly">[('employee_id', '!=', False)]</attribute>
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='department_id' and @groups='hr_contract.group_hr_contract_manager']" position="attributes">
                    <attribute name="readonly">[('employee_id', '!=', False)]</attribute>
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='job_id' and @groups='!hr_contract.group_hr_contract_manager']" position="attributes">
                    <attribute name="readonly">[('employee_id', '!=', False)]</attribute>
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='job_id' and @groups='hr_contract.group_hr_contract_manager']" position="attributes">
                    <attribute name="readonly">[('employee_id', '!=', False)]</attribute>
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
            </field>
        </record>
      
  </odoo>
