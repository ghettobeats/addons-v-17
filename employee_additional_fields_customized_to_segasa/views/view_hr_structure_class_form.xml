<odoo>

        <!-- hr.zone tree -->

        <record model="ir.ui.view" id="view_hr_structure_class_tree">
            <field name="name">HR STRUCTURE CLASS TREE</field>
            <field name="model">hr.structure.class</field>
            <field name="arch" type="xml">
                <tree string='Structure Class'>
                    <field name="id" widget="handle"/>
                    <field name="code" />
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_hr_structure_class_form">
            <field name="name">HR STRUCTURE CLASS FORM</field>
            <field name="model">hr.structure.class</field>
            <field name="arch" type="xml">
                <form string="Structure Class" version="17.0">
                    <sheet>
                        <group>
                            <group style="width: 25% !important;">
                                <field name="code" />
                            </group>
                            <group style="width: 75% !important;dis">
                                <label for="name" string="Structure Description Class" style="width: 190px !important;"/>
                                <div style="width: 400px !important;">
                                    <field name="name" style="margin-left: 30px !important;"/>
                                </div>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>


        <record id="view_hr_structure_class_filter" model="ir.ui.view">
            <field name="name">HR STRUCTURE CLASS FILTER</field>
            <field name="model">hr.structure.class</field>
            <field name="arch" type="xml">
                <search string="Search Structure Class">
                    <separator orientation="vertical"/>
                    <field name="name" filter_domain="[('name','ilike',self),('code','ilike',self)]"/>
                    <newline/>
                    <group expand="0" string="Group By...">
                        <!-- <filter name="line_id" string="LÃ­nea de Venta" icon="terp-personal" domain="[]"
                                context="{'group_by':'line_id'}"
                        /> -->
                    </group>
                </search>
            </field>
        </record>

        <record id="hr_structure_class_action" model="ir.actions.act_window">
            <field name="name">structure class SEGASA</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.structure.class</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_hr_structure_class_filter"/>
            <field name="domain">[]</field>
            <!-- <field name="context">{"search_default_type": 1,}</field> -->
            <field name="view_id" eval="False"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to add a new structure class.
                </p><p>
                With structure class display, you can add different.
            </p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem
            action="hr_structure_class_action"
            name="Structure Class Segasa"
            sequence="12"
            id="main_menu_hr_structure_class"
            parent="hr.menu_config_employee" />


    </odoo>
