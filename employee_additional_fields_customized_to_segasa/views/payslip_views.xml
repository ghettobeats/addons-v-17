<odoo>
    <record id="inherit_hr_payroll_view_hr_payslip_form" model="ir.ui.view">
      <field name="name">inherit.hr.payslip.form</field>
      <field name="model">hr.payslip</field>
      <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
      <field name="arch" type="xml">
        <xpath expr="//sheet/group[1]" position="inside">
          <field name="employee_identification_id" invisible="1"/>
          <field name="employee_identification" invisible="1"/>
          <field name="employee_department_id" invisible="1"/>
          <field name="employee_region" invisible="1"/>
        </xpath>
      </field>
    </record>
  </odoo>
