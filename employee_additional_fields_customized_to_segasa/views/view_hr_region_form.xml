<odoo>

        <!-- hr.region tree -->

        <record model="ir.ui.view" id="view_hr_region_tree">
            <field name="name">HR REGION TREE</field>
            <field name="model">hr.region</field>
            <field name="arch" type="xml">
                <tree string='Region' editable="top">
                    <field name="id" widget="handle"/>
                    <field name="code" />
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record id="view_hr_region_filter" model="ir.ui.view">
            <field name="name">HR REGION FILTER</field>
            <field name="model">hr.region</field>
            <field name="arch" type="xml">
                <search string="Search Region">
                    <separator orientation="vertical"/>
                    <field name="name" filter_domain="[('name','ilike',self),('code','ilike',self)]"/>
                    <newline/>
                    <group expand="0" string="Group By...">
                        <!-- <filter name="line_id" string="LÃ­nea de Venta" icon="terp-personal" domain="[]"
                                context="{'group_by':'line_id'}"
                        /> -->
                    </group>
                </search>
            </field>
        </record>

        <record id="hr_region_action" model="ir.actions.act_window">
            <field name="name">Region SEGASA</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.region</field>
            <field name="view_mode">tree</field>
            <field name="search_view_id" ref="view_hr_region_filter"/>
            <field name="domain">[]</field>
            <!-- <field name="context">{"search_default_type": 1,}</field> -->
            <field name="view_id" eval="False"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to add a new region.
                </p><p>
                With region display, you can add different.
            </p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem
            action="hr_region_action"
            name="Region Segasa"
            sequence="14"
            id="main_menu_hr_region"
            parent="hr.menu_config_employee" />


    </odoo>
