        <template id="journal_entry_report_template_id">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="bi_print_journal_entries.journal_entry_template_report_view" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

        <!--KEEPING THE SAME ID BUT CHANGED TO MITUR REQUIREMENTS-->
        <template id="journal_entry_template_report_view">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
                <div class="page" style="font-family:Arial, sans-serif; font-size:12px; color:#333;">

                    <!-- Título -->
                    <div style="text-align:center; margin-bottom:20px;">
                        <h2 style="border-bottom:2px solid #333; display:inline-block; padding-bottom:5px;">
                            ASIENTO CONTABLE
                        </h2>
                    </div>

                    <!-- Información del Asiento -->
                    <table style="width:100%; margin:10px auto; border-collapse:collapse; background:white; border:1px solid #ccc;">
                        <tbody>
                            <tr style="background:#f5f5f5;">
                                <th style="padding:6px; text-align:left;">Asiento N°:</th>
                                <td style="padding:6px;">
                                    <p t-field="o.name"/>
                                </td>
                                <th style="padding:6px; text-align:left;">Diario:</th>
                                <td style="padding:6px;">
                                    <p t-field="o.journal_id"/>
                                </td>
                            </tr>
                            <tr>
                                <th style="padding:6px; text-align:left;">Fecha:</th>
                                <td style="padding:6px;">
                                    <p t-field="o.date"/>
                                </td>
                                <th style="padding:6px; text-align:left;">Referencia:</th>
                                <td style="padding:6px;">
                                    <p t-field="o.ref"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Tabla de líneas contables -->
                    <table style="width:100%; margin:20px auto; border-collapse:collapse; background:white; border:1px solid #ccc;">
                        <thead style="background:#f0f0f0; text-align:center;">
                            <tr>
                                <th style="padding:6px;">Proveedor / Cliente</th>
                                <th style="padding:6px;">Cuenta</th>
                                <th style="padding:6px;">Concepto</th>
                                <th style="padding:6px;">Vencimiento</th>
                                <th style="padding:6px;">Cuenta Analítica</th>
                                <th style="padding:6px;">Impuestos (%)</th>
                                <th style="padding:6px;">Debe</th>
                                <th style="padding:6px;">Haber</th>
                            </tr>
                        </thead>
                        <tbody class="consumed_tbody">
                            <t t-set="total" t-value="0.0"/>
                            <t t-set="total1" t-value="0.0"/>
                            <t t-foreach="o.line_ids" t-as="line">
                                <tr>
                                    <td style="padding:6px;">
                                        <span t-field="line.partner_id"/>
                                    </td>
                                    <td style="padding:6px;">
                                        <span t-field="line.account_id"/>
                                    </td>
                                    <td style="padding:6px;">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td style="padding:6px; text-align:center;">
                                        <span t-field="line.date_maturity"/>
                                    </td>
                                    <td style="padding:6px;">
                                        <span t-field="line.analytic_account_id"/>
                                    </td>
                                    <td style="padding:6px; text-align:center;">
                                        <span t-field="line.tax_ids"/>
                                    </td>
                                    <td style="padding:6px; text-align:right;">
                                        <span t-field="line.debit"/>
                                    </td>
                                    <td style="padding:6px; text-align:right;">
                                        <span t-field="line.credit"/>
                                    </td>
                                </tr>
                                <t t-set="total" t-value="total + line.debit"/>
                                <t t-set="total1" t-value="total1 + line.credit"/>
                            </t>
                            <!-- Total -->
                            <tr style="background:#e8e8e8; font-weight:bold; border-top:2px solid #ccc;">
                                <td colspan="5"></td>
                                <td style="padding:6px; text-align:right;">Total:</td>
                                <td style="padding:6px; text-align:right;">
                                    <t t-esc="total"/>
                                </td>
                                <td style="padding:6px; text-align:right;">
                                    <t t-esc="total1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </t>
        </template>

    </data>
</odoo>