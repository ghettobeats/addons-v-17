<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="inherit_hr_payslip_run_form" model="ir.ui.view">
            <field name="name">inherit.hr.payslip.run.form</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='credit_note']" position="after">
                    <field name="gov_txt_file" attrs="{'invisible': [('gov_txt_file', '=', False)]}" readonly="1" filename="gov_txt_file_name"/>
                    <field name="gov_txt_file_name" invisible="1"/>
                </xpath>

                <xpath expr="//sheet" position="after">
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
