<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="gov_hr_payroll_txt_view_form" model="ir.ui.view">
        <field name="name">gov.hr.payroll.txt.view.form</field>
        <field name="model">gov.hr.payroll.txt</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="struct_id"/>
                        <field name="journal_id"/>
                    </group>
                    <group>
                        <field name="txt_binary_name" invisible="1"/>
                        <field
                            name="txt_binary"
                            filename="txt_binary_name"
                            widget="binary"
                            nolabel="1"/>
                    </group>
                </group>
                <footer>
                    <button name="generate_payroll" type="object" string="Generate Payroll" class="oe_highlight"/>
                    <button string="Close" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="gov_hr_payroll_txt_action" model="ir.actions.act_window">
        <field name="name">Create Government Payroll from TXT</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gov.hr.payroll.txt</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="hr_payroll.menu_hr_payslip_run"
        name="Payslip Batches"
        sequence="10"
        parent="hr_payroll.menu_hr_payroll_root"
        groups="hr_payroll.group_hr_payroll_user"
        action=""
    />

    <menuitem
        action="hr_payroll.action_hr_payslip_run_tree"
        id="menu_hr_payslip_run_tree"
        parent="hr_payroll.menu_hr_payslip_run"/>

    <menuitem
        id="gov_hr_payroll_txt_menu"
        action="gov_hr_payroll_txt_action"
        parent="hr_payroll.menu_hr_payslip_run"/>

</odoo>