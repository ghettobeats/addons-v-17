<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_currency" model="ir.ui.view">
        <field name="name">account.move.form.inherit.currency</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='currency_id']" position="replace">
                <field name="currency_id" groups="base.group_multi_currency" attrs="{'readonly': [('state', '!=', 'draft')]}"/>

            </xpath>

            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="recalculate_manual" invisible="1"/>
                <field name="is_currency_different" invisible="1"/>
                <label for="currency_rate_stored" groups="account.group_account_readonly"  attrs="{'invisible': [('is_currency_different', '=', False)]}"/>
                <div name="currency_rate_div" class="d-flex" attrs="{'invisible': [('is_currency_different', '=', False)]}" >
                <field name="currency_rate" invisible="1"/>
                <field name="currency_rate_stored" force_save="1" attrs="{'readonly': ['|',('recalculate_manual', '=', False),('state', '!=', 'draft')],'invisible': [('is_currency_different', '=', False)]}"/>

                <span class="oe_inline o_form_label mr-3 ml-5 oe_edit_only" attrs="{'invisible': [('state', '!=', 'draft')]}"> manual? </span>
                <field name="recalculate_manual" widget="boolean_toggle" groups="base.group_multi_currency" attrs="{'readonly': [('state', '!=', 'draft')],'invisible': ['|', ('is_currency_different', '=', False),('state', '!=', 'draft')]}"/>
                </div>
<!--                <button name="recalculate_amount_currency"-->
<!--                        icon="fa-spinner" title="Recalculate_currency" string="Recalcular tasa" type="object" groups="account.group_account_invoice"-->
<!--                        attrs="{'invisible': ['|', ('recalculate_manual', '!=', True), ('state', 'in', ('posted','cancel'))]}"/>-->
            </xpath>


        </field>
    </record>



</odoo>
