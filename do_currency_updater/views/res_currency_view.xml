<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_currency_rate_tree" model="ir.ui.view">
        <field name="name">view_currency_rate_tree</field>
        <field name="model">res.currency.rate</field>
        <field name="inherit_id" ref="base.view_currency_rate_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rate']" position="replace">
                <field name="rate" readonly="1" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='rate']" position="before">
                <field name="manual_currency" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='rate']" position="after">
                <field name="converted" readonly="1" force_save="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_currency_form" model="ir.ui.view">
        <field name="name">view_currency_form</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rate']" position="after">
                <field name="converted"/>
            </xpath>
        </field>
    </record>

    <record id="view_currency_tree" model="ir.ui.view">
        <field name="name">view_currency_tree</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rate']" position="after">
                <field name="converted"/>

            </xpath>
        </field>
    </record>






</odoo>
