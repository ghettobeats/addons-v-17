<odoo>

    <!-- Action to asign contact and account to employees -->
    <record model="ir.actions.server" id="employee_assign_contact">
        <field name="name">Asignar contacto y cuenta de banco</field>
        <field name="model_id" ref="hr_payroll.model_hr_employee"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_employee"/>
	<field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
        <field name="state">code</field>
        <field name="code">
            records.assign_contact()
        </field>
    </record>
    
</odoo>
