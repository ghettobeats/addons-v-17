<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_correspondence" model="ir.module.category">
            <field name="name">Correspondencia</field>
            <field name="description">Helps you manage your internal correspondence.</field>
             <field name="parent_id" ref="base.module_category_administration"/>
            <field name="sequence">15</field>
        </record>

        <record id="correspondence_officer_group" model="res.groups">
            <field name="name">Oficial</field>
            <field name="category_id" ref="correspondence_management.module_category_correspondence"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <record id="correspondence_manager_group" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="correspondence_management.module_category_correspondence"/>
            <field name="implied_ids" eval="[(4, ref('correspondence_officer_group'))]"/>
        </record>

    </data>
</odoo>