<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--        Correspondence views -->
        <record id="correspondence_view_tree" model="ir.ui.view">
            <field name="name">correspondence_view_tree</field>
            <field name="model">correspondence</field>
            <field name="arch" type="xml">
                <tree edit="false">
                    <header>
                        <!--                        <button name='action_receive' string="Recibir" type="object" class="btn-secondary border border-info ml-2"/>-->
                        <!--                        <button name='action_delivery' string="Entregar" type="object" class="oe_highlight ml-2" />-->
                        <button name='action_cancel' string="Cancelar" type="object" class="btn-secondary ml-2"/>
                    </header>
                    <field name="name"/>
                    <field name="correspondence_type" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="employee_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    <field name="department_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    <field name="sender_id" optional="hide"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'"
                           decoration-success="state == 'delivered'"
                           decoration-warning="state == 'received'"/>
                    <field name="received_date"/>
                    <field name="delivery_date"/>
                    <button name='action_print' string="Imprimir recibo" type="object" class="btn-link"
                            attrs="{'invisible': [('state', '!=', 'received')]}" icon="fa-solid fa-print"/>
                </tree>
            </field>
        </record>

        <record id="correspondence_view_form" model="ir.ui.view">
            <field name="name">correspondence_view_form</field>
            <field name="model">correspondence</field>
            <field name="arch" type="xml">
                <form string="correspondence_form">
                    <header>
                        <field name="state" widget="statusbar" options="{'clickable': False, 'fold_field': 'fold'}"/>
                        <button name='action_receive' string="Recibir" type="object" class="oe_highlight ml-2"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name='action_cancel' string="Cancelar" type="object" class="btn-secondary"
                                attrs="{'invisible': ['|', ('state', '=', 'cancel'), ('state', '=', 'delivered')]}"/>
                        <button name='action_delivery' string="Entregar" type="object" class="oe_highlight ml-2"
                                attrs="{'invisible': [('state', '!=', 'received')]}"/>
                        <button name='action_draft' string="Devolver a borrador" type="object" class="btn-secondary"
                                attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="action_print" string="Imprimir recibo" icon="fa-file-text-o"
                                    class="btn-secondary"
                                    type="object"/>
                        </div>
                        <group name="group top">
                            <group name="group right">
                                <field name="name" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="correspondence_type" widget="many2many_tags"
                                       options="{'color_field': 'color'}"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="sender_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="external_messenger" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="received_date" force_save="1"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                            <group name="group left">
                                <field name="employee_id"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="department_id"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="internal_messenger"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="delivery_date"
                                       attrs="{'invisible': [('delivery_date', '=', False)],'readonly': [('state', '!=', 'draft')]}"
                                />
                            </group>
                        </group>

                        <group name="group bottom">
                            <field name="supported_attachment_ids" widget="many2many_binary"
                                   options="{'open_attachments': True}"
                                   attrs="{'invisible': [('state', '!=', 'delivered')]}"/>
                            <field name="description"
                                   attrs="{'invisible': [('state', '!=', 'delivered')],'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>


        <record id="correspondence_view_search" model="ir.ui.view">
            <field name="name">correspondence_view_search</field>
            <field name="model">correspondence</field>
            <field name="arch" type="xml">
                <search>
                    <filter name="correspondence_received" string="Recibidos" domain="[('state', '=', 'received')]"/>
                    <filter name="correspondence_draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                    <filter name="correspondence_delivered" string="Entregados" domain="[('state', '=', 'delivered')]"/>
                    <filter name="correspondence_canceled" string="Cancelados" domain="[('state', '=', 'cancel')]"/>
                    <filter name="filter_date_delivery" date="delivery_date" />
                    <group expand="1" string="Agrupar por">
                        <filter string="Estado" name="group_state" context="{'group_by':'state'}"/>
                        <separator/>
                        <filter string="Destino" name="group_department_id" context="{'group_by':'department_id'}"/>
                        <filter string="Destinatario" name="group_employee_id" context="{'group_by':'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!--        Internal Messengers views -->
        <record id="internal_messengers_view_tree" model="ir.ui.view">
            <field name="name">internal_messengers_view_tree</field>
            <field name="model">correspondence.internal.messenger</field>
            <field name="arch" type="xml">
                <tree editable="top">
                    <field name="employee_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    <field name="job_id" readonly="1"/>
                    <field name="department_id" readonly="1"/>
                </tree>
            </field>
        </record>

        <!--        Correspondence Types views -->
        <record id="correspondence_types_view_tree" model="ir.ui.view">
            <field name="name">correspondence types tree</field>
            <field name="model">correspondence.types</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="color" widget="color_picker"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>