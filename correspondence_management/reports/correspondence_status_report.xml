<odoo>
    <template id="correspondence_status_report">
        <t t-call="web.html_container">
            <div class="article">
                <div class="page">
                    <link href="https://fonts.googleapis.com/css2?family=Quattrocento:wght@400;700" rel="stylesheet"/>
                    <div class="oe_structure"/>
                    <header>
                        <div class="container Quattrocento" style="font-family: 'Quattrocento', serif">
                            <div class="row" style="heigth:20px">
                                <div class="row justify-content-center mt-5" style="width: 1185px">
                                    <div class="col-4" style="padding-left:8px; padding-right:0px;">
                                        <img style="width: 42%;"
                                             src="/Visitantes/static/src/img/logo_mitur.png"
                                             alt="Imagen no encontrada"/>
                                    </div>
                                    <div class="col-5 text-center"
                                         style="padding-left:0px; padding-right:60px; padding-top: 26px">
                                        <h3 style="font-size: 30px">
                                            <b>MINISTERIO DE TURISMO</b>
                                        </h3>
                                        <h4 style="line-height: 0px;">
                                            <b>
                                                <em>Dirección Administrativa</em>
                                            </b>
                                        </h4>
                                    </div>
                                    <div class="col-3 text-right">
                                        <b>
                                            <p style="margin: 0px;">
                                                Página:<span class="page"/>
                                            </p>
                                            <p style="margin: 0px;">
                                                Fecha:
                                                <t t-esc="time.strftime('%d/%m/%Y')"/>
                                            </p>
                                        </b>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 text-center"
                                     style="margin: 1px; padding:1px; font-size: 20px;">
                                    <b>LISTADO DE CORRESPONDENCIA ENTREGADA</b>
                                </div>
                            </div>
                        </div>
                        <div class="container border border-dark">
                            <div class="row mt-1 mb-2 border-dark" style="height: 50px;">
                                <div class="col-2 text-center " style="padding-top: 12px">
                                    <b>Asunto</b>
                                </div>
                                <div class="col-2 text-center" style="justify-content: left; padding-top: 12px">
                                    <b>Destinatario</b>
                                </div>
                                <div class="col-3 text-center"
                                     style=" padding-top: 12px;">
                                    <b>Destino
                                    </b>
                                </div>
                                <div class="col-3 text-center"
                                     style="text-align: center; padding-top: 12px;">
                                    <b>Fecha de recepción

                                    </b>
                                </div>
                                <div class="col-2 text-center"
                                     style="width: 100%;height: auto; padding-top: 12px">
                                    <b>Fecha de entrega
                                    </b>
                                </div>
                            </div>
                        </div>
                    </header>
                    <body>
                        <t t-foreach="docs" t-as="doc">
                            <t t-if="doc.state == 'delivered'">
                                <div class="container">
                                    <div class="row  mt-2 border-top border-dark" style="font-size:13px; height: 50px;">
                                        <div class="col-2 text-center" style="padding-top: 8px;">
                                            <t t-esc="doc.name"/>
                                        </div>
                                        <div class="col-2 text-center" style="padding-top: 8px;">
                                            <t t-esc="doc.employee_id.name"/>
                                        </div>
                                        <div class="col-3 text-center" style="padding-top: 8px;">
                                            <p>
                                                <t t-esc="doc.department_id.name"/>
                                            </p>
                                        </div>
                                        <div class="col-3 text-center" style="padding-top: 8px;">
                                            <p>
                                                <t t-esc="doc.received_date"/>
                                            </p>
                                        </div>
                                        <div class="col-2 text-center" style="height: auto;  padding-top: 8px;">
                                            <t t-esc="doc.delivery_date"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <t t-else=""></t>
                        </t>
                    </body>
                </div>
            </div>
        </t>
    </template>


    <template id="change_with_your_unique_id">
        <t t-call="web.html_container">
            <div class="article">
                <div class="page">
                    <div class="oe_structure"/>
                    <header>

                    </header>
                    <body>
                        <t t-foreach="docs" t-as="doc"> <!--Order t-foreach depends on what you want to repeat-->
                            <div class="container">

                            </div>
                        </t>
                    </body>
                    <footer>

                    </footer>
                </div>
            </div>
        </t>
    </template>

    <record id="correspondence_paperformat_id" model="report.paperformat">
        <field name="name">Paper format correspondence</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <record id="correspondence_status_report_view_form" model="ir.actions.report">
        <field name="name">Listado de correspondencia</field>
        <field name="model">correspondence</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_file">correspondence_management.correspondence_status_report</field>
        <field name="report_name">correspondence_management.correspondence_status_report</field>
        <field name="binding_model_id" ref="model_correspondence"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="correspondence_paperformat_id"/>
    </record>

</odoo>