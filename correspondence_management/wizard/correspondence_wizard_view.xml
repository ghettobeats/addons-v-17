<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="correspondence_wizard_view_form" model="ir.ui.view">
            <field name="name">correspondence_wizard_view_form</field>
            <field name="model">correspondence.wizard</field>
            <field name="arch" type="xml">
                <form string="correspondence_wizard_view_form">
                    <sheet>
                        <group>
                            <field name="name" readonly="True"/>
                            <field name="department_id" readonly="True"/>
                            <field name="internal_messenger" readonly="True"/>
                            <field name="delivery_date" readonly="True"/>
                            <field name="supported_attachment_ids" widget="many2many_binary" options="{'open_attachments': True}"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name='action_done' string="Guardar" class="btn-primary" type="object"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>