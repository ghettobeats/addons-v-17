<odoo>
    <template id="hr_expenses_local_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="env.company"/>
                <div class="article">
                    <div class="page">
                        <div class="oe_structure"/>
                        <header>
                            <!--SECTION HEADER-->
                            <div class="container">
                                <div class="row">
                                    <div class="col-4">
                                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                             style="max-height: 80px;" alt="Logo"/>
                                    </div>
                                    <div class="col-4 text-lg-center text-center">
                                        <img t-if="company.l10n_do_gov_header_center_image"
                                             t-att-src="image_data_uri(company.l10n_do_gov_header_center_image)"
                                             style="max-height: 80px;" alt="Escudo"/>
                                        <p t-field="company.l10n_do_gov_header_center_data"/>
                                    </div>
                                    <div class="col-4 text-lg-right text-right">
                                        <img t-if="company.l10n_do_gov_header_right_image"
                                             t-att-src="image_data_uri(company.l10n_do_gov_header_right_image)"
                                             style="max-height: 80px;" alt="Programa"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <p style="margin-bottom: 0px;" class="text-center">
                                            <t t-if="doc.x_studio_es_compensacion == False">
                                                <span style="color: rgb(73, 80, 87); font-size: 24px;">Cálculo de
                                                    Viáticos Locales
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span style="color: rgb(73, 80, 87); font-size: 24px;">Cálculo de
                                                    Compensación
                                                </span>
                                            </t>
                                            <br/>
                                        </p>
                                        <p style="margin-bottom: 0px;" class="text-center">
                                            <span style="color: rgb(73, 80, 87); font-size: 15px">Dirección de Recursos
                                                Humanos
                                            </span>
                                            <br/>
                                        </p>
                                        <p style="margin-bottom: 0px;" class="text-center">
                                            <span style="color: rgb(73, 80, 87); font-size: 14px; font-weight: 500">
                                                División de Relaciones Laborales
                                            </span>
                                            <br/>
                                        </p>
                                    </div>
                                </div>
                                <div style="margin-top: 50px;"/>
                                <div class="row">
                                    <div class="col-12">
                                        <p style="margin-bottom: 0px;">
                                            <br/>
                                        </p>
                                    </div>
                                </div>
                                <div class="row" style="margin-bottom: 15px">
                                    <div class="col-4">
                                        <p style="margin-bottom: 0px;">
                                            <strong>Número de Oficio</strong>
                                            <br/>
                                            <span t-field="doc.name"/>
                                        </p>
                                    </div>
                                    <div class="col-4">
                                        <strong>Empleado:</strong>
                                        <br/>
                                        <span t-field="doc.employee_id"/>
                                    </div>
                                    <div class="col-4">
                                        <strong>Nº identificación:</strong>
                                        <br/>
                                        <span t-field="doc.employee_id.identification_id"/>
                                    </div>
                                </div>
                                <div class="row" style="margin-bottom: 15px">
                                    <div class="col-4">
                                        <strong>Departamento:</strong>
                                        <br/>
                                        <span t-field="doc.employee_id.department_id.name"/>
                                    </div>
                                    <div class="col-4">
                                        <strong>Desde:</strong>
                                        <br/>
                                        <span t-field="doc.x_studio_desde"/>
                                    </div>
                                    <div class="col-4">
                                        <strong>Hasta:</strong>
                                        <br/>
                                        <span t-field="doc.x_studio_hasta"/>
                                    </div>
                                </div>
                                <div class="row" style="margin-bottom: 15px">
                                    <div class="col-4">
                                        <strong>Puesto del trabajo:</strong>
                                        <br/>
                                        <span t-field="doc.employee_id.job_title"/>
                                    </div>
                                    <div class="col-7">
                                        <strong>Motivo del Viaje:</strong>
                                        <br/>
                                        <span t-field="doc.x_studio_motivo_del_viaje"/>
                                    </div>
                                </div>
                            </div>
                            <div style="margin-top: 50px;"/>
                        </header>
                        <body>
                            <div class="container">
                                <table class="table"
                                       style="width: 100%; page-break-inside: auto; border-collapse: collapse;">
                                    <thead>
                                        <tr style="page-break-before: always;">
                                            <th class="text-center" style="color: gray; border: 1px solid black;">
                                                FECHA
                                            </th>
                                            <th class="text-center" style="color: gray; border: 1px solid black;">
                                                CONCEPTO
                                            </th>
                                            <th class="text-center" style="color: gray; border: 1px solid black;">CUENTA
                                                OBJECTAL
                                            </th>
                                            <th class="text-center" style="color: gray; border: 1px solid black;">MONTO
                                                RD$
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody style="page-break-inside: avoid;">
                                        <t t-foreach="doc.expense_line_ids" t-as="table_line">
                                            <tr style="page-break-inside: avoid;">
                                                <td class="text-center" style="border: 1px solid black;">
                                                    <span t-field="table_line.date"/>
                                                </td>
                                                <td class="text-center" style="border: 1px solid black;">
                                                    <span t-field="table_line.display_name"/>
                                                </td>
                                                <td class="text-center" style="border: 1px solid black;">
                                                    <span t-field="table_line.analytic_account_id"/>
                                                </td>
                                                <td class="text-center"
                                                    style="background-color: rgb(224, 219, 219); border: 1px solid black;">
                                                    <span t-esc="'{:,.2f}'.format(round(table_line.unit_amount, 2))"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="row">
                                <div class="col-3"/>
                                <div class="col-3"/>
                                <div class="col-3"/>
                                <div class="col-3" style="margin-left:0px">
                                    <span>
                                        <p style="margin-bottom: 0px;">
                                            <strong>Total:</strong>
                                        </p>
                                    </span>
                                    <span t-field="doc.total_amount"/>
                                </div>
                            </div>
                            <div style="margin-top: 50px;"/>
                            <div class="row" style="page-break-inside: avoid;">
                                <div class="col-4 text-center">
                                    <p style="margin-bottom: 65px;">
<!--                                        <t t-if="doc.x_firma_solicitante">-->
<!--                                            <img t-att-src="image_data_uri(doc.x_firma_solicitante)"-->
<!--                                                 style="max-height: 6rem; max-width: 100%;"/>-->
<!--                                        </t>-->
                                        <span style="color: rgb(73, 80, 87); font-size: 15px">Preparado por</span>
                                        <br/>
                                    </p>
                                    <hr class="border-dark"/>
                                </div>
                                <div class="col-4 text-center">
                                    <p style="margin-bottom: 65px;">
                                        <span style="color: rgb(73, 80, 87); font-size: 15px">Autorizado por</span>
                                        <br/>
                                    </p>
                                    <hr class="border-dark"/>
                                </div>
                                <div class="col-4 text-center">
                                    <p style="margin-bottom: 65px;">
                                        <span style="color: rgb(73, 80, 87); font-size: 15px">Aprobado por</span>
                                        <br/>
                                    </p>
                                    <hr class="border-dark"/>
                                </div>
                            </div>
                        </body>
                        <footer>
                            <div class="row">
                                <div class="col-12 text-right footer">
                                    <p style="font-size: small"><strong><span t-esc="doc.name"/></strong></p>
                                </div>
                            </div>
                        </footer>
                    </div>
                </div>
            </t>
        </t>
    </template>


    <record id="viaticos_locales_paperformat" model="report.paperformat">
        <field name="name">Viaticos Locales PaperFormat</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15.00</field>
        <field name="margin_bottom">30.00</field>
        <field name="margin_left">7.00</field>
        <field name="margin_right">7.00</field>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_record_hr_expenses_local_document" model="ir.actions.report">
        <field name="name">Informe de Cálculo de Viáticos Locales</field>
        <field name="model">hr.expense.sheet</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_file">hr_expense_sheet.hr_expenses_report_viaticos</field>
        <field name="report_name">hr_expense_sheet.hr_expenses_local_document</field>
        <field name="binding_model_id" ref="hr_expense.model_hr_expense_sheet"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="hr_expense_sheet.viaticos_locales_paperformat"/>
    </record>


</odoo>
