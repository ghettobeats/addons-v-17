<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_account_journal_form" model="ir.ui.view">
            <field name="name">account.journal.form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">

            <xpath expr="//page[@id='inbound_payment_settings']" position="attributes">
                <field name="attrs">{'invisible': [('type', 'not in', ['cash', 'bank','general'])]}</field>
            </xpath>

            <xpath expr="//page[@id='outbound_payment_settings']" position="attributes">
                <field name="attrs">{'invisible': [('type', 'not in', ['cash', 'bank','general'])]}</field>
            </xpath>

                    <xpath expr="//field[@name='type']" position="after">
                        <field name="is_advance_payment"
                            attrs="{'invisible': [('type', 'not in', ('bank', 'cash', 'general'))]}"/>
                    </xpath>
                    <xpath expr="//field[@name='refund_sequence']" position="before">
                        <field name="recovery_sequence_id"
                          attrs="{'invisible': [('is_advance_payment', '=', False)]}"/>
                    </xpath>

            </field>
        </record>

        <record id="view_move_form_smile" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_register_payment']" position="after">
                <field name="is_sn_advanced" invisible="1"/>
                <button name="do_recover_advance_payments"
                        id="recover_advance_payments_btn" type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', '|', ('is_sn_advanced', '=', False), ('payment_state', 'not in', ('not_paid', 'partial')), ('move_type', 'not in', ('out_invoice', 'in_invoice', 'out_receipt', 'in_receipt'))]}"
                        string="Asign advances" groups="account.group_account_invoice"/>
            </xpath>
        </field>
        </record>


    </data>
</odoo>
