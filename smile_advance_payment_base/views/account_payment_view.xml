<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_account_payment_form" model="ir.ui.view">
            <field name="name">account.payment.form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                        <button name="button_open_invoices_advanced" type="object"
                                    class="oe_stat_button" icon="fa-bars"
                                    attrs="{'invisible': [('advanced_invoices_count','=', 0)]}">
                                <field name="advanced_invoices_count"/>
                                <span attrs="{'invisible': [('advanced_invoices_count','&gt;', 1)]}">Advanced Invoice</span>
                                <span attrs="{'invisible': [('advanced_invoices_count','&lt;=', 1)]}">Advanced Invoices</span>
                            </button>

                            <!-- Bill stat button -->
                            <button name="button_open_bills_advanced" type="object"
                                    class="oe_stat_button" icon="fa-bars"
                                    attrs="{'invisible': [('advanced_bills_count','=', 0)]}">
                                <field name="advanced_bills_count"/>
                                <span attrs="{'invisible': [('advanced_bills_count','&gt;', 1)]}">Advanced Bill</span>
                                <span attrs="{'invisible': [('advanced_bills_count','&lt;=', 1)]}">Advanced Bills</span>
                            </button>
                </xpath>
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="is_advance_payment" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="stored_advance_residual" attrs="{'invisible': [('is_advance_payment','=', False)]}" readonly="1" string="Avance sin compensar" force_save="1"/>
                    <field name="assign_advance_manually" attrs="{'invisible': [('stored_advance_residual','=', 0)]}"/>
                    <field name="recovery_ids" mode="tree,kanban"  attrs="{'invisible': [('is_advance_payment','=',False)],'readonly': [('assign_advance_manually', '=', False)]}"
                    context="{'default_payment_id': id, 'default_company_id': company_id,}">
                         <tree>
                                <field name="amount" string="Monto compensado" sum="Total"/>
                                <field name="move_id" string="Movimiento compensatorio"/>
                         </tree>
                         <form>
                             <group>
                             <group string="Info del pago avanzado">
                                  <field name="payment_id" string="Pago asociado" readonly="1" force_save="1"/>
                                  <field name="amount" string="Monto compensado"/>
                                  <field name="currency_id" string="Moneda" readonly="1" force_save="1"/>
                             </group>
                             <group string="Info del movimiento compensatorio">
                                  <field name="invoice_id" string="Factura afectada (si la hay)"
                                         help="En caso de no haber factura relacionada, favor seleccionar en este campo
                                                el mismo movimiento compensatorio"/>
                                  <field name="company_id" string="Compania" readonly="1" force_save="1"/>
                                  <field name="move_id" string="Movimiento compensatorio"/>

                             </group>

                             </group>

                         </form>

                    </field>

                </xpath>
                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="domain">[('type', 'in', ('bank', 'cash', 'general'))]</attribute>
                    <attribute name="widget"></attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
