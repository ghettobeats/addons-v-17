<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_partner_property_form" model="ir.ui.view">
            <field name="name">res.partner.property.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="advanced_outgoing_count" invisible="1"/>
                    <button class="oe_stat_button" name="button_open_outbound_advanced" type="object"
                        icon="fa-sign-out" help="Advance outgoing payments" attrs="{'invisible': [('advanced_outgoing_count', '=', 0)]}">
                        <field string="Outgoing advancements" name="advanced_outgoing_count" widget="statinfo"/>
                    </button>
                    <field name="advanced_incoming_count" invisible="1"/>
                    <button class="oe_stat_button" name="button_open_inbound_advanced" type="object"
                        icon="fa-sign-in" help="Advance incoming payments" attrs="{'invisible': [('advanced_incoming_count', '=', 0)]}">
                        <field string="incoming advancements" name="advanced_incoming_count" widget="statinfo"/>
                    </button>
                 </xpath>


                <xpath expr="//field[@name='property_account_payable_id']" position="after">
                    <field name="property_account_receivable_advance_id" required="1"/>
                    <field name="property_account_payable_advance_id" required="1"/>
                </xpath>


            </field>
        </record>

    </data>
</odoo>
