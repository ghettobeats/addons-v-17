<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_get_advaces_wizard_form" model="ir.ui.view">
            <field name="name">get.advaces.wizard.form</field>
            <field name="model">get.advaces.wizard</field>
            <field name="arch" type="xml">
                <form string="Avances de facturas">
                    <!-- Invisible fields -->

                    <field name="wizard_customer_id" invisible="1" />
                    <field name="wizard_move_type" invisible="1" />
                    <field name="advance_ids" widget="many2many" domain="[('stored_advance_residual', '>', 0),
                    ('partner_id', '=', wizard_customer_id),('state', '=', 'posted'),('payment_type', '=', wizard_move_type)]">
                        <tree>
                             <field name="name"/>
                             <field name="partner_id" string="Partner"/>
                             <field name="currency_id"/>
                             <field name="amount"/>
                            <field name="stored_advance_residual" />
                            </tree>
                    </field>

                    <footer>
                        <button icon="fa-cogs" string="Generar compensacion de avances" name="compute_advance" type="object" class="oe_highlight"  />
                        <button string="Cerrar" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>