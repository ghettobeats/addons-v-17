<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id='purchase_gov_purchase_mode_tree' model='ir.ui.view'>
        <field name="name">purchase.gov.purchase.mode.tree.</field>
        <field name="model">purchase.gov.purchase.mode</field>
        <field name="arch" type="xml">
            <tree string="Purchase Mode" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="purchase_gov_purchase_mode_action" model="ir.actions.act_window">
        <field name="name">Purchase Gov Purchase Mode</field>
        <field name="res_model">purchase.gov.purchase.mode</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Purchase Mode
            </p>
        </field>
    </record>

    <menuitem id="menu_purchase_config_purchase_mode" name="Purchase Mode"
              parent="purchase.menu_purchase_config"
              action="l10n_do_gov_purchase.purchase_gov_purchase_mode_action" />

</odoo>