<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_payment_form_inherided" model="ir.ui.view">
        <field name="name">account.payment.form.inherited</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='communication']" position="after">
                <field name="allow_check_release" invisible="1"/>
                <field name="release_number"
                       attrs="{'invisible':[('allow_check_release','!=',True)],
                               'required':[('allow_check_release','=',True)],
                               'readonly': [('state', '!=', 'draft')]}"/>
            </xpath>
        </field>
    </record>

    <record id="account_payment_tree_view_inherided" model="ir.ui.view">
        <field name="name">account.payment.tree.inherited</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='payment_method_id']" position="after">
                <field name="release_number"/>
            </xpath>
        </field>
    </record>

    <record id="account_payment_wizard_inherit" model="ir.ui.view">
        <field name="name">account.payment.wizard.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='communication']" position="after">
                <field name="allow_check_release" invisible="1"/>
                <field name="release_number"
                       attrs="{'invisible':[('allow_check_release','!=',True)],
                               'required':[('allow_check_release','=',True)]}"/>
            </xpath>
        </field>
    </record>

    <record id="account_register_payment_wizard_inherit" model="ir.ui.view">
        <field name="name">account.register.payment.wizard.inherit</field>
        <field name="model">account.register.payments</field>
        <field name="inherit_id" ref="account.view_account_payment_from_invoices"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='communication']" position="after">
                <field name="allow_check_release" invisible="1"/>
                <field name="release_number"
                       attrs="{'invisible':[('allow_check_release','!=',True)],
                               'required':[('allow_check_release','=',True)]}"/>
            </xpath>
        </field>
    </record>

</odoo>
