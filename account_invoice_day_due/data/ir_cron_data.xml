<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="compute_due_days_cron" model="ir.cron">
        <field name="name">Update invoices due days</field>
        <field name="model_id" ref="model_account_invoice"/>
        <field name="state">code</field>
        <field name="code">model.search([])._compute_due_days()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall"
               eval="(DateTime.now() + timedelta(days=1)).replace(hour=4, minute=5, second=00, microsecond=00)" />
    </record>

</odoo>
