<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="bank_cheque_issued_view_form" model="ir.ui.view">
        <field name="name">issued.bank.cheque.history.view.form</field>
        <field name="model">issued.bank.cheque.history</field>
        <field name="arch" type="xml">
            <form string="Cheque" create="false">
                <header>
                    <button name="print_cheque" string="Print Cheque" type="object" attrs="{'invisible':[('state', 'in', ['printed', 'cancelled'])]}" class="oe_highlight"/>
                    <button name="do_cancel_cheque" string="Cancel" type="object" attrs="{'invisible':[('state', '=', 'cancelled')]}"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <field name="id" invisible="1"/>
                    <group>
                        <group>
                            <field name="cheque_number" readonly="1"/>
                            <field name="bank_cheque_book_id" readonly="1"/>
                            <field name="currency_id"/>
                            <field name="amount"/>
                            <field name="issued" invisible="1"/>
                            <field name="is_ac_pay"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="customer_id"/>
                            <field name="paid_to"/>
                            <field name="cheque_date"/>
                            <field name="issue_date" readonly="1" attrs="{'invisible': [('issue_date', '=', False)]}"/>
                            <field name="payment_id" readonly="1" attrs="{'invisible': [('payment_id', '=', False)]}"/>
                            <field name="cancelled" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bank_cheque_issued_view_tree" model="ir.ui.view">
        <field name="name">issued.bank.cheque.history.view.tree</field>
        <field name="model">issued.bank.cheque.history</field>
        <field name="arch" type="xml">
            <tree string="Issued Cheques" create="false" decoration-danger="state == 'cancelled'" decoration-success="state == 'printed'">
                <field name="bank_cheque_book_id"/>
                <field name="cheque_number"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="cheque_date"/>
                <field name="issue_date"/>
                <field name="amount"/>
                <field name="paid_to"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="bank_cheque_issued_action" model="ir.actions.act_window">
        <field name="name">Issued Cheques</field>
        <field name="res_model">issued.bank.cheque.history</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="bank_cheque_issued_menu" name="Issued Cheques"
              parent="odoo_cheque_management.wk_bank_cheque_management_menu"
              action="bank_cheque_issued_action" sequence="2" />
</odoo>