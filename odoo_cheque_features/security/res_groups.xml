<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_bank_cheque_user" model="res.groups">
        <field name="name">Cheque User</field>
        <field name="category_id" ref="module_category_cheque_management"/>
    </record>

    <record id="group_bank_cheque_manager" model="res.groups">
        <field name="name">Cheque Administrator</field>
        <field name="category_id" ref="module_category_cheque_management"/>
        <field name="implied_ids" eval="[(4, ref('group_bank_cheque_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="bank_cheque_book_comp_rule" model="ir.rule">
        <field name="name">Bank Cheque Book multi-company</field>
        <field name="model_id" ref="model_bank_cheque_book"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="issued_bank_cheque_history_comp_rule" model="ir.rule">
        <field name="name">Issued Bank Cheque History multi-company</field>
        <field name="model_id" ref="model_issued_bank_cheque_history"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>