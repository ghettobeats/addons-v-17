<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="invoice_bank_cheque_print_form_view_inherit" model="ir.ui.view">
            <field name="name">invoive.bank.cheque.print.inherit</field>
            <field name="model">invoice.print.bank.cheque.wizard</field>
            <field name="inherit_id" ref="odoo_cheque_management.invoice_bank_cheque_print_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//form/group/group/field[@name='date']" position="before">
                    <field name="user_is_cheque_manager" invisible="1" />
                </xpath>
                <xpath expr="//form/group/group/field[@name='date']" position="replace">
                    <field name="date" required="1" attrs="{'readonly': [('user_is_cheque_manager', '=', False)]}" />
                </xpath>
            </field>
        </record>
</odoo>