<odoo>
    <record id="view_hr_payslip_by_employees_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.by.employe.inherit</field>
        <field name="model">hr.payslip.employees</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_by_employees"/>
        <field name="arch" type="xml">
            <!--<xpath expr="//group[2]" position="replace"/>-->
            <xpath expr="//field[@name='employee_ids']" position="replace">
                <field name="employee_ids" nolabel="1" options="{'create': False, 'quick_create': False, 'no_open': True}">
                    <tree edit="0" limit="100" decoration-warning="not department_id and contract_warning == False"
                        decoration-danger="contract_warning == True">
                        <field name="name" optional="show"/>
                        <field name="department_id" string="Departamento" optional="show"/>
                        <field name="job_id" optional="show"/>
                        <field name="parent_id" invisible="1"/>
                        <field name="contract_warning" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
