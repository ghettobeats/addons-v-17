<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="account_move_line_action_move" model="ir.actions.act_window">
            <field name="name">Apuntes Contables</field>
            <field name="res_model">account.move.line</field>
            <field name="view_mode">tree</field>
            <field name="context">{'create': False}</field>
            <field name="domain">[('move_id', '=', active_id)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No hay apuntes contables para mostrar.
                </p>
                <p>
                    Aquí se mostrarán las líneas de los apuntes contables registrados en el sistema.
                </p>
            </field>
        </record>

        <!-- Inherit Form View to Modify it -->
        <record id="account_move_form_inherit_view" model="ir.ui.view">
            <field name="name">account_move_form_inherit_view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button
                            name="%(account_move_line_action_move)d"
                            id="account_move_line_button"
                            class="oe_stat_button"
                            type="action"
                            icon="fa-line-chart"
                            string="Apuntes Contables"

                    />
                </xpath>
            </field>
        </record>
    </data>
</odoo>