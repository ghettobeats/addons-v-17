<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="transfer_authorization_report">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.html_container">
                    <t t-call="web.external_layout">
                        <div class="oe_structure"/>
                        <div class="page">
                            <div class="row">
                                <div class="col-12">
                                    <t t-if="doc.journal_id.currency_id.full_name">
                                        <span t-field="doc.journal_id.currency_id.full_name" class="o_bold"/>
                                    </t>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <b>Número:</b>
                                    <t t-if="doc.check_number">
                                        <span t-field="doc.check_number"/>
                                    </t>
                                </div>
                            </div>
                            <div class="row" style="margin-bottom: 50px;">
                                <div class="col-3">
                                    <t t-if="doc.date">
                                        <span t-esc="doc.date.strftime('%d/%m/%Y')"/>
                                    </t>
                                </div>
                            </div>
                            <div class="row" style="margin-bottom:50px">
                                <div class="col">
                                    <span>
                                        <p style="margin-bottom: 0px;">
                                            <span style="font-size: medium;">Señores</span>
                                        </p>
                                        <p style="margin-bottom: 0px;">
                                            <span style="font-size: medium;">Banco de Reservas de la República
                                                Dominicana
                                            </span>
                                        </p>
                                    </span>
                                </div>
                            </div>
                            <br/>
                            <div class="row">
                                <div class="col">
                                    <t t-if="doc.journal_id.currency_id.currency_unit_label and
                                    doc.journal_id.bank_account_id.acc_number and
                                    doc.journal_id.currency_id.name and doc.amount and
                                    doc.check_amount_in_words"
                                    >
                                        <p>A traves de la presente autorizamos a debitar de nuestra cuenta en
                                            <span style="text-transform: lowercase; "
                                                  t-field="doc.journal_id.currency_id.currency_unit_label"/>
                                            no.
                                            <span t-field="doc.journal_id.bank_account_id.acc_number"/>
                                            el monto de<span t-field="doc.journal_id.currency_id.name"/>$
                                            <t t-esc="'{:,.2f}'.format(doc.amount)"
                                               widget="float" options="{'no_display_currency': True}"/>
                                            (<span t-field="doc.check_amount_in_words"/>)
                                            y transferir a:
                                        </p>
                                    </t>
                                </div>
                            </div>
                            <br/>
                            <div class="row">
                                <div class="col-12">
                                    <b>Código de proveedor:</b>
                                    <t t-if="doc.partner_id.vat">
                                        <span t-field="doc.partner_id.vat"/>
                                    </t>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <b>Nombre Proveedor:</b>
                                    <t t-if="doc.partner_id.name">
                                        <span t-field="doc.partner_id.name"/>
                                    </t>
                                </div>
                            </div>
                            <br/>
                            <t t-if="doc.x_entregar_a and not len(doc.x_entregar_a.bank_ids) > 1">
                                <div class="row">
                                    <div class="col-12">
                                        <b>Beneficiario:</b>
                                        <t t-if="doc.x_entregar_a.name">
                                            <span t-field="doc.x_entregar_a.name"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <b>Banco Receptor:</b>
                                        <t t-if="doc.x_entregar_a.bank_ids.bank_id.name">
                                            <span t-field="doc.x_entregar_a.bank_ids.bank_id.name"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <b>Número de Cuenta:</b>
                                        <t t-if="doc.x_entregar_a.bank_ids.acc_number">
                                            <span t-field="doc.x_entregar_a.bank_ids.acc_number"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <b>Moneda:</b>
                                        <t t-if="doc.journal_id.currency_id">
                                            <span t-field="doc.journal_id.currency_id"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <b>SWIFT:</b>
                                        <t t-if="doc.x_entregar_a.bank_ids.bank_id.bic">
                                            <span t-field="doc.x_entregar_a.bank_ids.bank_id.bic"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <b>Dirección:</b>
                                        <t t-if="doc.x_entregar_a.bank_ids.bank_id.street">
                                            <span t-field="doc.x_entregar_a.bank_ids.bank_id.street"/>
                                        </t>
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="row">
                                    <div class="col-12">
                                        <b>Banco Receptor:</b>
                                        <t t-if="doc.partner_bank_id.bank_id.name">
                                            <span t-field="doc.partner_bank_id.bank_id.name"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <b>Número de Cuenta:</b>
                                        <t t-if="doc.partner_bank_id.acc_number">
                                            <span t-field="doc.partner_bank_id.acc_number"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <b>Moneda:</b>
                                        <t t-if="doc.partner_bank_id.currency_id">
                                            <span t-field="doc.partner_bank_id.currency_id"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <b>SWIFT:</b>
                                        <t t-if="doc.partner_bank_id.bank_id.bic">
                                            <span t-field="doc.partner_bank_id.bank_id.bic"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <b>Dirección:</b>
                                        <t t-if="doc.partner_bank_id.bank_id.street">
                                            <span t-field="doc.partner_bank_id.bank_id.street"/>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <br/>
                        <div class="row">
                            <div class="col-12">
                                <b>Concepto:</b>
                                <t t-if="doc.ref">
                                    <span t-field="doc.ref"/>
                                </t>
                            </div>
                        </div>
                        <br/>
                        <div class="row">
                            <div class="col-12">
                                <b>Mercado:</b>
                                <t t-if="doc.partner_id.country_id.x_studio_market">
                                    <span t-field="doc.partner_id.country_id.x_studio_market"/>
                                </t>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <t t-if="doc.partner_id.country_id.name">
                                    <span t-field="doc.partner_id.country_id.name"/>
                                </t>
                            </div>
                        </div>
                        <div class="row"
                             style="margin-top:40px;margin-top:50px;margin-top:50px;margin-top:100px">
                            <div class="col-3 offset-1">
                                <span>
                                    <span>
                                        Firma Autorizada
                                    </span>
                                    <br/>
                                </span>
                            </div>
                            <div class="col-3 offset-3 text-left">
                                <span>
                                    <span>
                                        Firma Autorizada
                                    </span>
                                    <br/>
                                </span>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="action_transfer_authorization_report" model="ir.actions.report">
            <field name="name">Autorización de Transferencia (Corregido)</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_file">account_payment_reports.transfer_authorization_report</field>
            <field name="report_name">account_payment_reports.transfer_authorization_report</field>
            <!--            <field name="binding_model_id" ref="account.model_account_payment"/> -->
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>