<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="x_cash_delivery_authorization_transfer_report">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.html_container">
                    <t t-call="web.external_layout">
                        <div class="oe_structure"/>
                        <div class="page">
                            <div class="row">
                                <div class="col-12">
                                    <t t-if="doc.x_journal_id.currency_id.full_name">
                                        <span t-field="doc.x_journal_id.currency_id.full_name" class="o_bold"/>
                                    </t>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <b>Núm.:</b>
                                    <t t-if="doc.x_name">
                                        <span t-field="doc.x_name"/>
                                    </t>
                                </div>
                            </div>
                            <div class="row" style="margin-bottom: 50px;">
                                <div class="col-3">
                                    <t t-if="doc.x_date">
                                        <span t-esc="doc.x_date.strftime('%d/%m/%Y')"/>
                                    </t>
                                </div>
                            </div>

                            <div class="row" style="margin-bottom:50px">
                                <div class="col">
                                    <span>
                                        <p style="margin-bottom: 0px;">
                                            <span style="font-size: medium;">Dr.Leonardo Aguilera Batista</span>
                                        </p>
                                        <p style="margin-bottom: 0px;">
                                            <span style="font-size: medium;">Presidente Ejecutivo</span>
                                        </p>

                                        <p style="margin-bottom: 0px;">
                                            <span style="font-size: medium;">Banco de Reservas la Rep. Dominicana, Banco
                                                Múltiple
                                                <br/>
                                                Su Despacho
                                            </span>
                                        </p>
                                    </span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12">
                                    <span>
                                        <p style="margin-bottom: 0px; font-size: medium;">Atención a la señora Doris
                                            Laura
                                            Uribe
                                            Velázquez
                                        </p>
                                    </span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12" style="padding-left: 87px;">
                                    <p style="margin-bottom: 0px; font-size: medium;">Vicepresidenta Ejecutiva de
                                        Negocios Gubernamentales
                                    </p>
                                </div>
                            </div>
                            <br/>
                            <div class="row">
                                <div class="col-12">
                                    <p>Estimados señores:</p>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">
                                    <t t-if="doc.x_journal_id.currency_id.currency_unit_label and
                                    doc.x_journal_id.bank_account_id.acc_number and
                                    doc.x_journal_id.currency_id.name and doc.x_monto and
                                    doc.x_check_amount_in_words and doc.x_proveedor_id"
                                    >
                                        <p>Sirva la presente para solicitarle el débito a nuestra cuenta en
                                            <span style="text-transform: lowercase; "
                                                  t-field="doc.x_journal_id.currency_id.currency_unit_label"/>
                                            no.
                                            <span t-field="doc.x_journal_id.bank_account_id.acc_number"/>
                                            el monto de<span t-field="doc.x_journal_id.currency_id.name"/>$
                                            <t t-esc="'{:,.2f}'.format(doc.x_monto)"
                                               widget="float" options="{'no_display_currency': True}"/>
                                            (<span t-field="doc.x_check_amount_in_words"/>)
                                            para ser transferido a
                                            <span t-field="doc.x_proveedor_id"/>, portador
                                            de la cédula de identidad y electoral no.
                                            <span t-field="doc.x_proveedor_id.vat"/>.
                                        </p>
                                    </t>
                                </div>
                            </div>

                            <div class="row"
                                 style="margin-top:40px;margin-top:50px;margin-top:50px;margin-top:100px">
                                <div class="col-3 offset-1">
                                    <span>
                                        <span>
                                            Firma Autorizada
                                        </span>
                                        <br/>
                                    </span>
                                </div>
                                <div class="col-3 offset-3 text-left">
                                    <span>
                                        <span>
                                            Firma Autorizada
                                        </span>
                                        <br/>
                                    </span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="offset-1 col-6">
                                    <span>
                                        <b>
                                            Mérida Rojas
                                        </b>
                                    </span>
                                </div>
                                <div class="col-3 text-left">
                                    <span>
                                        <b>
                                            Yaneris Then
                                        </b>
                                    </span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-3 offset-1">
                                    <span>
                                        <b>
                                            Directora Financiera
                                        </b>
                                    </span>
                                </div>
                                <div class="offset-3 col-3 col-4 text-left">
                                    <span>
                                        <b>
                                            Vice Ministra Administrativa
                                        </b>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="x_action_cash_delivery_authorization_transfer_report" model="ir.actions.report">
            <field name="name">Imprimir Informe de Pago Extranjeros (Transferencia)</field>
            <field name="model">x_pagos_lotes_moneda_extranjera_final</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">account_payment_reports.x_cash_delivery_authorization_transfer_report</field>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>