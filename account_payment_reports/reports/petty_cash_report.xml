<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="petty_cash_report">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.html_container">
                    <t t-call="web.external_layout">
                        <div class="oe_structure"/>
                        <div class="page">

                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="action_petty_cash_report" model="ir.actions.report">
            <field name="name">Reporte Caja Chica</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_file">account_payment_reports.proof_of_delivery_of_funds</field>
            <field name="report_name">account_payment_reports.proof_of_delivery_of_funds</field>
            <!--            <field name="binding_model_id" ref="account.model_account_payment"/> -->
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>