<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="office_benefits_report">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.html_container">
                    <t t-call="web.external_layout">
                        <div class="oe_structure"/>
                        <div class="page">
                            <div class="row" style="text-align:center;">
                                <div class="col-12">
                                    <b>Relación de Pagos Beneficios Personal Oficina del Exterior</b>
                                </div>
                            </div>
                            <div class="row" style="text-align:center;">
                                <div class="col-12">
                                    <t t-if="doc.currency_id.full_name">
                                        Moneda en
                                        <span t-field="doc.currency_id.full_name"/>
                                    </t>
                                </div>
                            </div>
                            <div class="container">
                                <div class="row">
                                    <div class="col-12">
                                        <b>Fecha:</b>
                                        <t t-if="doc.date">
                                            <span t-field="doc.date"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <b>Transferencia:</b>
                                        <t t-if="doc.name">
                                            <span t-field="doc.name"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <b>Total:</b>
                                        <t t-if="doc.currency_id.symbol and doc.amount">
                                            <span t-field="doc.currency_id.symbol"/>
                                            <t t-esc="'{:,.2f}'.format(doc.amount)"
                                               widget="float" options="{'no_display_currency': True}"/>
                                        </t>
                                    </div>
                                </div>
                                <table class="table"
                                       style="width: 100%; page-break-inside: auto; border-collapse: collapse;">
                                    <thead>
                                        <tr style="page-break-before: always;">
                                            <th class="text-center" style="border: 1px solid black;">
                                                TARJETA
                                            </th>
                                            <th class="text-center" style="border: 1px solid black;">
                                                CEDULA
                                            </th>
                                            <th class="text-center" style="border: 1px solid black;">
                                                DESCRIPCION
                                            </th>
                                            <th class="text-center" style=" border: 1px solid black;">
                                                <t t-if="doc.currency_id.symbol">
                                                    MONTO
                                                    <span t-field="doc.currency_id.symbol"/>
                                                </t>
                                            </th>
                                            <th class="text-center" style="border: 1px solid black;">
                                                CARGO
                                            </th>
                                            <th class="text-center" style="border: 1px solid black;">
                                                PAIS
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody style="page-break-inside: avoid;" >
                                        <t t-foreach="doc.payment_ids" t-as="line">
                                            <tr style="page-break-inside: avoid;">
                                                <td class="text-center" style="border: 1px solid black;">
                                                    <t t-if="line.name">
                                                        <t t-esc="line.name"/>
                                                    </t>
                                                </td>
                                                <td class="text-center" style="border: 1px solid black;">
                                                    <t t-if="line.partner_bank_id.partner_id.vat">
                                                        <t t-esc="line.partner_bank_id.partner_id.vat"/>
                                                    </t>
                                                </td>
                                                <td class="text-center" style="border: 1px solid black;">
                                                    <t t-if="line.partner_bank_id.partner_id.name">
                                                        <b>Beneficiario:</b>
                                                        <t t-esc="line.partner_bank_id.partner_id.name"/>
                                                    </t>
                                                </td>
                                                <td class="text-center"
                                                    style="background-color: rgb(224, 219, 219); border: 1px solid black;">
                                                    <t t-if="line.amount_signed">
                                                        <span t-field="doc.currency_id.symbol"/>
                                                        <t t-esc="line.amount_signed"/>
                                                    </t>
                                                </td>
                                                <td class="text-center"
                                                    style="background-color: rgb(224, 219, 219); border: 1px solid black;">
                                                    <t t-if="line.partner_bank_id.partner_id.employee_ids.job_id">
                                                        <t t-esc="line.partner_bank_id.partner_id.employee_ids.job_id.name"/>
                                                    </t>
                                                </td>
                                                <td class="text-center"
                                                    style="background-color: rgb(224, 219, 219); border: 1px solid black;">
                                                    <t t-if="line.partner_bank_id.partner_id.country_id.name">
                                                        <t t-esc="line.partner_bank_id.partner_id.country_id.name"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                <br/>
                                <div class="row" style="margin-top:20px" >
                                    <div class="col-6 text-center">
                                        <span>
                                            Firma Autorizada
                                        </span>
                                    </div>
                                    <div class="col-6 text-center">
                                        <span>
                                            Firma Autorizada
                                        </span>
                                    </div>
                                </div>
                                <br/>
                                <div class="row">
                                    <div class="col-12">
                                        <t t-if="doc.currency_id.full_name and doc.journal_id.bank_account_id.acc_number">
                                            <p><b>Nota: </b>La Comisión y la Diferencia cambiaria, Favor cargarla a
                                                nuestra cuenta en
                                                <t t-esc="doc.currency_id.full_name"/>
                                                No.
                                                <t t-esc="doc.currency_id.full_name and doc.journal_id.bank_account_id.acc_number"/>
                                            </p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="action_office_benefits_report" model="ir.actions.report">
            <field name="name">Beneficios Oficinas</field>
            <field name="model">account.batch.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_file">account_payment_reports.office_benefits_report</field>
            <field name="report_name">account_payment_reports.office_benefits_report</field>
            <!--            <field name="binding_model_id" ref="account.model_account_payment"/> -->
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>