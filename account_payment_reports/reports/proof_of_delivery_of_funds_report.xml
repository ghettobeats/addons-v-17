<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="proof_of_delivery_of_funds_report">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.html_container">
                    <t t-call="web.external_layout">
                        <div class="oe_structure"/>
                       <div class="page">
                            <div class="container">
                                <div class="text-center">
                                    <h5>Dirección Financiera</h5>
                                    <div class="title">Comprobante Entrega de Fondos</div>
                                </div>
                                <div style="margin-top:50px">
                                    <div class="row" style="margin-bottom: 10px">
                                        <div class="col-6">
                                            <strong>Número:</strong>
                                            <t t-if="doc.x_studio_numero_de_recibo_definitivo">
                                                <span t-field="doc.x_studio_numero_de_recibo_definitivo"/>
                                            </t>
                                            <t t-else="">
                                                <span t-field="doc.numero_de_libramiento"/>
                                            </t>
                                        </div>
                                    </div>

                                    <div class="row" style="margin-bottom: 10px">
                                        <div class="col-12">
                                            <strong>Entregar a:</strong>
                                            <t t-if="doc.partner_id">
                                                <span t-field="doc.x_entregar_a"/>
                                            </t>
                                            <t t-else="">
                                                <span t-field="doc.partner_id"/>
                                            </t>
                                        </div>
                                    </div>
                                    <div class="row" style="margin-bottom: 10px">
                                        <div class="col-6">
                                            <strong>Cédula:</strong>
                                            <span t-field="doc.partner_id.vat"/>
                                        </div>
                                    </div>

                                    <div class="row" style="margin-bottom: 10px">
                                        <div class="col-12">
                                            <strong>La suma de:</strong>
                                            <span t-field="doc.currency_id.symbol"/>
                                            <span t-esc="'{:,.2f}'.format(doc.amount)"/>
                                            (<span t-field="doc.check_amount_in_words"/>)
                                        </div>
                                    </div>

                                    <div class="row" style="margin-bottom: 40px">
                                        <div class="col-12">
                                            <strong>Concepto:</strong>
                                            <t t-if="doc.x_concepto">
                                                <span t-field="doc.x_concepto"/>
                                            </t>
                                        </div>
                                    </div>

                                    <div class="row" style="margin-top: 100px">
                                        <div class="col-4 text-left">
                                            <span>
                                                <span>
                                                    Autorizado por:
                                                </span>
                                                <br/>
                                            </span>
                                        </div>
                                        <div class="col-4 text-left">
                                            <span>
                                                <span>
                                                    Entregado por:
                                                </span>
                                                <br/>
                                            </span>
                                        </div>
                                        <div class="col-4 text-left">
                                            <span>
                                                <span>
                                                    Recibido por:
                                                </span>
                                                <br/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="action_proof_of_delivery_of_funds_report" model="ir.actions.report">
            <field name="name">Comprobante de Entrega de Fondos</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_file">account_payment_reports.proof_of_delivery_of_funds_report</field>
            <field name="report_name">account_payment_reports.proof_of_delivery_of_funds_report</field>
            <!--            <field name="binding_model_id" ref="account.model_account_payment"/> -->
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>