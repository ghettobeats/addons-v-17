<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="l10n_do_account_batch_payment_wizard_form" model="ir.ui.view">
        <field name="name">l10n.do.account.batch.payment.wizard.form</field>
        <field name="model">l10n_do.account.batch.payment</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="journal_id"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="email" widget="email" invisible="1"/>
                        <field name="total_to_pay" widget="monetary"/>
                        <field name="filename" invisible="1"/>
                        <field name="file" filename="filename" readonly="1"
                               attrs="{'invisible': [('file', '=', False)]}"/>
                    </group>
                </group>
                <field name="payment_ids"
                       attrs="{'invisible': [('journal_id', '=', False)]}"
                       domain="[('payment_type', '=', 'outbound'), ('journal_id', '=', journal_id), ('state', '=', 'posted')]">
                    <tree default_order="date">
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="ref"/>
                        <field name="state" invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="generate_bank_file" string="Generate" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_do_account_batch_payment_wizard_action"
            model="ir.actions.act_window">
        <field name="name">Generate Payment File</field>
        <field name="res_model">l10n_do.account.batch.payment</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_do_account_batch_payment_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
