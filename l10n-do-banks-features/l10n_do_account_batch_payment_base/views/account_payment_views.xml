<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_payment_form_multi_inherited" model="ir.ui.view">
        <field name="name">view.account.payment.form_multi.inherited</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="payment_date" position="after">
                <field name="l10n_do_show_bank_acc" invisible="1"/>
                <field name="partner_bank_id"
                       options="{'no_create': True, 'no_open': True}"
                       attrs="{'invisible': [('l10n_do_show_bank_acc', '=', False)]}"/>
            </field>
        </field>
    </record>

</odoo>
