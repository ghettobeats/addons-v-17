<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_payment_tree_inherited" model="ir.ui.view">
        <field name="name">view.account.payment.tree.inherited</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="mode">primary</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_bank_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_batch_payment_form_inherited" model="ir.ui.view">
        <field name="name">view.batch.payment.form.inherited</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_ids']/tree/field[@name='partner_id']"
                   position="after">
                <field name="partner_bank_id"/>
            </xpath>
            <xpath expr="//field[@name='payment_ids']" position="attributes">
                <attribute name="context">{'default_payment_type': batch_type, 'default_journal_id': journal_id, 'default_payment_method_id': payment_method_id, 'tree_view_ref': 'view_account_payment_tree_inherited'}</attribute>
            </xpath>
        </field>
    </record>

    <record id="account_batch_payment.action_batch_payment_out" model="ir.actions.act_window">
        <field name="domain" eval="[('batch_type', 'in', ('outbound', 'transfer'))]"/>
    </record>

</odoo>
