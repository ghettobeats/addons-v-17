<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_category_action_form" model="ir.actions.act_window">
        <field name="name">Product Categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.category</field>
        <field name="view_type">form</field>
        <field name="search_view_id" ref="product.product_category_search_view"/>
        <field name="view_id" ref="product.product_category_list_view"/>
    </record>

    <menuitem id="product_product_menu_sellable"
              name="Products Categories"
              action="product_category_action_form"
              parent="account.menu_finance_receivables"
              sequence="999"/>

    <record id="view_account_journal_form_inherited" model="ir.ui.view">
        <field name="name">view.account.journal.form.inherited</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='group_invoice_lines']" position="after">
                <field name="commission" attrs="{'invisible': [('type', 'not in', ['cash', 'bank'])]}"/>
            </xpath>
        </field>
    </record>

</odoo>