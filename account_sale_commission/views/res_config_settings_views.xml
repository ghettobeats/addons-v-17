<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherited" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherited</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invoicing_settings']" position="after">
                <h2 groups="account.group_account_manager">Commission</h2>
                <div class="row mt16 o_settings_container" id="commission_settings"
                     groups="account.group_account_manager">
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <div class="text-muted">
                                Commission entries setup
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label string="Commission Journal" for="commission_journal_id"
                                           class="col-md-3 o_light_label"/>
                                    <field name="commission_journal_id"
                                           domain="[('company_id', '=', company_id), ('type', '=', 'general')]"/>
                                </div>
                                <div class="row mt16">
                                    <label for="commission_debit_account"
                                           class="col-md-3 o_light_label"/>
                                    <field name="commission_debit_account"
                                           domain="[('company_id', '=', company_id), ('deprecated', '=', False)]"/>
                                </div>
                                <div class="row mt16">
                                    <label for="commission_credit_account"
                                           class="col-md-3 o_light_label"/>
                                    <field name="commission_credit_account"
                                           domain="[('company_id', '=', company_id), ('deprecated', '=', False)]"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="commission_schema" string="Commission Schema"/>
                            <div class="text-muted">
                                How commission entries should be registered
                            </div>
                            <div class="content-group">
                                <field name="commission_schema" class="o_light_label mt16" widget="radio"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="commission_base" string="Commission Base"/>
                            <div class="text-muted">
                                What amount base should be taken for commission calculation
                            </div>
                            <div class="content-group">
                                <field name="commission_base" class="o_light_label mt16" widget="radio"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="commission_beneficiary" string="Commission Beneficiary"/>
                            <div class="text-muted">
                                Who would receive the commission
                            </div>
                            <div class="content-group">
                                <field name="commission_beneficiary" class="o_light_label mt16" widget="radio"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="commission_currency_rate" string="Commission Currency Rate"/>
                            <div class="text-muted">
                                What currency rate should use
                            </div>
                            <div class="content-group">
                                <field name="commission_currency_rate" class="o_light_label mt16" widget="radio"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="move_date" string="Journal Entry Date"/>
                            <div class="text-muted">
                                What date should the Commission journal entry take
                            </div>
                            <div class="content-group">
                                <field name="move_date" class="o_light_label mt16" widget="radio"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>