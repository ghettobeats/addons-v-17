<odoo>
    <record id="view_hr_payroll_currency_rate_tree" model="ir.ui.view">
        <field name="name">hr.payroll.currency.rate.tree</field>
        <field name="model">hr.payroll.currency.rate</field>
        <field name="arch" type="xml">
            <tree string="Tasas de Cambio para Nómina" editable="bottom">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" options="{'no_create': True}"/>
                <field name="rate"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_payroll_currency_rate_form" model="ir.ui.view">
        <field name="name">hr.payroll.currency.rate.form</field>
        <field name="model">hr.payroll.currency.rate</field>
        <field name="arch" type="xml">
            <form string="Tasa de Cambio para Nómina">
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="currency_id" options="{'no_create': True}"/>
                        <field name="rate"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_currency_rate" model="ir.actions.act_window">
        <field name="name">Tasas de Cambio para Nómina</field>
        <field name="res_model">hr.payroll.currency.rate</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Configura una tasa de cambio fija por moneda, usada solo
                para Nómina. Es independiente de la tasa que usa Contabilidad.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_hr_payroll_currency_rate"
        name="Tasas de Cambio para Nómina"
        parent="hr_work_entry_contract_enterprise.menu_hr_payroll_configuration"
        sequence="90"
        action="action_hr_payroll_currency_rate"
        groups="hr_payroll.group_hr_payroll_manager"/>
</odoo>
