<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_expense_tree" model="ir.ui.view">
        <field name="name">view.petty.cash.expense.tree</field>
        <field name="model">petty.cash.expense</field>
        <field name="arch" type="xml">
            <tree string="Petty Cash Expense">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="tipo_caja_id"/>
                <field name="date"/>
                <field name="petty_journal_id" optional="show"/>
                <field name="company_id" optional="hide"/>
                <field name="user_id" optional="show"/>
                <field name="expense_amount"/>
                <field name="currency_id" invisible="1"/>
                <field name="categoria" invisible="1"/>
                <field name="faltan_facturas" widget="boolean_toggle"/>
                <field name="faltan_pagos" widget="boolean_toggle"/>
                <field name="stage_id" widget="badge" decoration-success="categoria == 'payment'"
                       decoration-info="categoria == 'approval'" decoration-warning="categoria == 'invoice'"
                       decoration-muted="categoria == 'cancel'"/>
            </tree>
        </field>
    </record>

    <record id="view_petty_cash_expense_form" model="ir.ui.view">
        <field name="name">view.petty.cash.expense.form</field>
        <field name="model">petty.cash.expense</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Expense">
                <header>
                    <field name="next_stage_id" invisible="1"/>
                    <field name="boton_final" invisible="1"/>
                    <field name="categoria" invisible="1"/>
                    <field name="faltan_facturas" invisible="1"/>
                    <field name="faltan_pagos" invisible="1"/>


                    <button name="action_cancel" string='Cancelar'
                            type='object' class="oe_highlight"
                            attrs="{'invisible': [('categoria', '=', 'cancel')]}"/>
                    
                    <button type="object" class="btn btn-primary" string="Aprobar y Pasar a Siguiente"
                            name="action_next_step"
                            attrs="{'invisible': [('next_stage_id', '=', False)]}">
                        <field name="nombre_boton"/></button>

                    <button type="object" class="btn btn-primary" string="Crear Documentos Contables"
                            name="crear_facturas_relacionadas"
                            attrs="{'invisible': ['|',('categoria', '!=', 'invoice'),('faltan_facturas','=',False)]}"/>

                    <button type="object" class="btn btn-primary" string="Crear Pagos"
                            name="create_payment"
                            attrs="{'invisible': ['|',('categoria', '!=', 'payment'),('faltan_pagos','=',False)]}"/>
                    
                    <field name="stage_id" widget="statusbar" options="{'clickable': 0}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            attrs="{'invisible': [('payment_count', '=', 0)]}">
                            <field name="payment_count" widget="statinfo" string="Pagos"/>
                        </button>
                        <button name="action_view_invoices"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            attrs="{'invisible': [('invoice_count', '=', 0)]}">
                            <field name="invoice_count" widget="statinfo" string="Facturas"/>
                        </button>
                        <button name="action_get_attachment_view"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            type="object">
                            <field name="attachment_number" widget="statinfo" string="Documentos"/>
                        </button>
                    </div>
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="employee_id" required='1'/>
                            <field name="payment_journal_id" required='1'/>
                            <field name="petty_journal_id" required='1'/>
                            <field name="tipo_caja_id"/>
                        </group>
                        <group>
                            <field name="date" required='1'/>
                            <field name="currency_id" invisible='1'/>
                            <field name="user_id" required='1' readonly="1"/>
                            <field name="company_id" required='1'/>
                            <field name="payment_ids" widget="many2many_tags" invisible="1"/>
                            <field name="analytic_account_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string='Lineas de Gastos'>
                            <field name="expense_lines" context="{'default_currency_id':currency_id,'default_analytic_account_id':analytic_account_id}">
                                <tree>
                                    <field name="company_id" invisible="1"/>
                                    <field name="date" required="1"/>
                                    <field name="partner_id" required="1"/>
                                    <field name="employee_id" />
                                    <field name="product_id" required="1"/>
                                    <field name='account_id' required="1"/>
                                    <field name="analytic_account_id"/>
                                    <field name="unit_amount" widget="monetary" required="1"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="total_amount" widget="monetary" required="1"/>
                                    <field name="attachment_number" invisible="1"/>
                                    <widget name="attach_document" highlight="1" string="Adjuntar Archivo" action="message_post"
                                attrs="{'invisible': [('attachment_number', '&gt;=', 1)]}"/>
                                    <button name="action_get_attachment_view" string="Ver Adjuntos" type="object"
                                            icon="fa-paperclip" attrs="{'invisible': [('attachment_number', '=', 0)]}"/>
                                    <field name="tipo_de_factura_do"  widget='badge'
                                               decoration-info="tipo_de_factura_do == 'gasto_menor'"
                                               decoration-warning="tipo_de_factura_do == 'informal'"
                                               decoration-success="tipo_de_factura_do == 'fiscal'"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="company_id" invisible="1"/>
                                            <field name="date" required="1"/>
                                            <field name="partner_id" required="1"/>
                                            <field name="employee_id" />
                                            <field name="attachment_number" invisible="1"/>
                                            <widget name="attach_document" highlight="1" string="Adjuntar Archivo" action="message_post"
                                attrs="{'invisible': [('attachment_number', '&gt;=', 1)]}"/>
                                            <field name="product_id" required="1"/>
                                            <field name='account_id' required="1"/>
                                            <field name="analytic_account_id"/>
                                            <field name="analytic_tag_ids" widget="many2many_tags"/>
                                            <field name="payment_reference"/>
                                            <field name="tipo_de_factura_do"/>
                                            <field name="ncf" attrs="{'invisible':[('tipo_de_factura_do','!=','fiscal')]}"/>
                                        </group>
                                        <group>
                                            <field name="account_move_id" readonly="1" force_save="1"/>
                                            <field name="currency_id" invisible="1"/>
                                            <field name='unit_amount' widget="monetary" required="1"/>
                                            <field name="tax_ids" widget="many2many_tags"/>
                                            <field name='total_amount' widget="monetary" readonly="1" force_save="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                                <group colspan="4">
                                    <field name="note" nolabel="1" placeholder="Terms and conditions..."/>
                                </group>
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                                    <field name="balance" widget="monetary" options="{'currency_field': 'currency_id'}" force_save="1"/>
                                    <field name="expense_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                        <label for="remaining_balace"/>
                                    </div>
                                    <field name="remaining_balace" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </group>
                                <div class="oe_clear"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>  
            </form>
        </field>
    </record>


    <record id="dev_petty_cash_expense_filter" model="ir.ui.view">
        <field name="name">petty.cash.expense.filter</field>
        <field name="model">petty.cash.expense</field>
        <field name="arch" type="xml">
            <search string="Petty Cash">
                <field name="name" string='Petty Cash'/>
                <field name="employee_id"/>
                <field name="date"/>
                <filter string="En Aprobacion" name="approval" domain="[('categoria','=','approval')]"/>
                <filter string="En Emision de Facturas" name="invoice" domain="[('categoria','=','invoice')]"/>
                <filter string="En Pago" name="payment" domain="[('categoria','=','payment')]"/>
                <filter string="Canceladas" name="cancel" domain="[('categoria','=','cancel')]"/>
                <filter string="Date" name="date" date="date"/>

                <group expand="0" string="Group By">
                    <filter name="employee_id" string="Employee" domain="[]" context="{'group_by':'employee_id'}"/>
                    <filter name="petty_journal_id" string="Petty Cash Journal" domain="[]" context="{'group_by':'petty_journal_id'}"/>
                    <filter name="company_id" string="Company" domain="[]" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_petty_cash_expense" model="ir.actions.act_window">
        <field name="name">Caja Chica Dinamica</field>
        <field name="res_model">petty.cash.expense</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Agregar Gasto de Caja Chica
            </p>
        </field>
    </record>



    <record id="tipo_caja_chica_view_kanban" model="ir.ui.view" >
        <field name="name">tipo.caja.chica.dashboard</field>
        <field name="model">tipo.caja.chica</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard o_salesteam_kanban" create="0" sample="1">
                <field name="name"/>
                <field name="team_head"/>
                <field name="team_members"/>
                <field name="color"/>
                <field name="balance_caja_chica"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''}">
                            <div t-attf-class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary"><field name="name"/></div>
                                </div>
                                <div class="o_kanban_manage_button_section">
                                    <a class="o_kanban_manage_toggle_button" href="#"><i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/></a>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content">
                                <div class="row o_kanban_card_upper_content">
                                    <div class="col-4 o_kanban_primary_left" name="to_replace_in_sale_crm">
                                        <button type="object" class="btn btn-primary" name="action_view_cajas">Ver Cuadres</button>
                                    </div>
                                </div>
                            </div>

                            <div id="dashboard_bank_cash_right" class="col-12 col-sm-7 o_kanban_primary_right">
                                <div class="row">
                                    <div id="dashboard_bank_cash_balance" class="col overflow-hidden text-left">
                                        <strong title="Balance en Caja">Balance en Caja: </strong>
                                    </div>
                                    <div class="col-auto text-right">
                                        <span><field  widget="monetary" name="balance_caja_chica"/></span>
                                        <span><field name="currency_id" invisible="1"/></span>
                                    </div>
                                </div>

                            </div>
                            <div class="container o_kanban_card_manage_pane dropdown-menu" role="menu">

                                <div t-if="widget.editable" class="o_kanban_card_manage_settings row" groups="sales_team.group_sale_manager">
                                    <div role="menuitem" aria-haspopup="true" class="col-8">
                                        <ul class="oe_kanban_colorpicker" data-field="color" role="menu"/>
                                    </div>
                                    <div role="menuitem" class="col-4">
                                        <a class="dropdown-item" type="edit">Configuracion</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-name="JournalBodyBankCash">
                        <t t-value="record.balance_caja_chica.raw_value" t-set="balance_caja_chica"/>
                        <!-- On the right, show other common informations/actions -->
                        <div id="dashboard_bank_cash_right" class="col-12 col-sm-7 o_kanban_primary_right">
                            <div class="row" t-if="balance_caja_chica &gt; 0">
                                <div id="dashboard_bank_cash_balance" class="col overflow-hidden text-left">
                                    <span title="Balance in General Ledger">Balance en Caja: </span>
                                </div>
                                <div class="col-auto text-right">
                                    <span><field name="balance_caja_chica"/></span>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_petty_cash_expense_type_form" model="ir.ui.view">
        <field name="name">tipo.caja.chica.form</field>
        <field name="model">tipo.caja.chica</field>
        <field name="arch" type="xml">
            <form string="Tipos de Caja Chica">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_cajas"
                            type="object"
                                string="Cajas Chicas Relacionadas"
                            icon="fa-pencil-square-o">
                        </button>
                    </div>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="company_id" required="1"/>
                            <field name="team_head"/>
                            <field name="team_members" widget="many2many_tags"/>
                            <field name="stage_ids" widget="many2many_tags"/>

                        </group>
                        <group>
                            <field name="petty_journal_id"/>
                            <field name="balance_caja_chica"/>
                            <field name="invoice_journal_id"/>
                            <field name="payment_journal_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>



    <record id="action_petty_cash_expense_type" model="ir.actions.act_window">
        <field name="name">Caja Chica Dinamica: Tipos</field>
        <field name="res_model">tipo.caja.chica</field>
        <field name="view_mode">kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Visualizar tipos de caja chica.
            </p>
        </field>
    </record>

    <record id="view_caja_chica_estados_tree" model="ir.ui.view">
        <field name="name">caja.chica.estados.tree</field>
        <field name="model">caja.chica.estados</field>
        <field name="arch" type="xml">
            <tree string="Estados de Caja Chica">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="categoria"/>
                <field name="cajas_ids" widget="many2many_tags"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="view_caja_chica_estados_form" model="ir.ui.view">
        <field name="name">caja.chica.estados.form</field>
        <field name="model">caja.chica.estados</field>
        <field name="arch" type="xml">
            <form string="Estados de Caja Chica">
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="company_id" required="1"/>
                            <field name="nombre_boton" required='1' />
                            <field name="boton_final" />
                            <field name="categoria"/>
                            <field name="usuarios_permitidos_ids" widget="many2many_tags"/>
                            <field name="cajas_ids" widget="many2many_tags"/>

                        </group>
                        <group>
                            <field name="next_stage_id"/>
                            <field name="condition"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_caja_chica_estados" model="ir.actions.act_window">
        <field name="name">Caja Chica Dinamica: Estados</field>
        <field name="res_model">caja.chica.estados</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Visualizar los estados de caja chica.
            </p>
        </field>
    </record>


    <!--Menus-->

    <menuitem name="Caja Chica Dinamica" id="dev_petty_cash_expense_root_menu"
              action="action_petty_cash_expense_type" sequence="1" groups="dev_petty_cash.group_petty_user"
     web_icon="dev_petty_cash,static/description/icon.png"/>

    <menuitem id="dev_petty_cash_expense_tipos_menu" name="Caja Chica Dinamica: Tipos"
        parent="dev_petty_cash.dev_petty_cash_expense_root_menu"
        action="action_petty_cash_expense_type"
         groups="dev_petty_cash.group_petty_user"
        sequence="1"/>

    <menuitem id="dev_petty_cash_expense_registros_menu" name="Caja Chica Dinamica: Registros"
        parent="dev_petty_cash.dev_petty_cash_expense_root_menu"
        action="action_petty_cash_expense"
         groups="dev_petty_cash.group_petty_user"
        sequence="2"/>


    <menuitem name="Solicitud de Efectivo" id="dev_petty_cash_request_menu"
              parent="dev_petty_cash.dev_petty_cash_expense_root_menu"
              action="action_petty_cash_request" sequence="3" groups="dev_petty_cash.group_petty_user"/>

    <menuitem name="Estados de Caja Chica" id="dev_petty_cash_stages_menu"
              parent="dev_petty_cash.dev_petty_cash_expense_root_menu"
              action="action_caja_chica_estados" sequence="3" groups="dev_petty_cash.group_petty_user"/>

</odoo>
