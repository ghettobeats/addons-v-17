<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="caja_chica_move_view" model="ir.ui.view">
            <field name="name">Move Name</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <field name="caja_chica_id" invisible="1"/>
                    <button type="object"
                            name="action_view_caja_chica"
                            string="Caja Chica Relacionada" icon="fa-money"
                            attrs="{'invisible':['|','|',('state','=','draft'),('caja_chica_id', '=', False),
                            ('move_type', 'in', ('out_invoice', 'out_refund', 'entry'))]}">
                    </button>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
