<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="dev_petty_cash_request" model="ir.sequence">
            <field name="name">Petty Cash Request</field>
            <field name="code">petty.cash.request</field>
            <field name="prefix">PREQ/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="dev_petty_cash_expense" model="ir.sequence">
            <field name="name">Petty Cash Expense</field>
            <field name="code">petty.cash.expense</field>
            <field name="prefix">PEXP/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>


        <record id="default_caja_id" model="tipo.caja.chica">
            <field name="name">Caja Chica General</field>
            <field name="sequence">1</field>
        </record>

        <record id="state_cancel" model="caja.chica.estados">
            <field name="sequence">6</field>
            <field name="name">Cancelado</field>
            <field name="categoria">cancel</field>
            <field name="boton_final">True</field>
        </record>

        <record id="state_payment" model="caja.chica.estados">
            <field name="sequence">5</field>
            <field name="name">Pagado</field>
            <field name="categoria">payment</field>
            <field name="boton_final">True</field>
        </record>

        <record id="state_account" model="caja.chica.estados">
            <field name="sequence">4</field>
            <field name="name">Registrado Contablemente</field>
            <field name="categoria">invoice</field>
            <field name="nombre_boton">Procesar Pagos</field>
            <field name="next_stage_id" eval="ref('dev_petty_cash.state_payment')"/>
        </record>

        <record id="state_approval" model="caja.chica.estados">
            <field name="sequence">3</field>
            <field name="name">En Aprobacion</field>
            <field name="categoria">approval</field>
            <field name="nombre_boton">Pasar A Registro Contable</field>
            <field name="next_stage_id" eval="ref('dev_petty_cash.state_account')"/>
        </record>

        <record id="state_progress" model="caja.chica.estados">
            <field name="sequence">2</field>
            <field name="name">En Progreso</field>
            <field name="categoria">approval</field>
            <field name="nombre_boton">Marcar Para Aprobacion</field>
            <field name="next_stage_id" eval="ref('dev_petty_cash.state_approval')"/>
        </record>


        <record id="state_draft" model="caja.chica.estados">
            <field name="sequence">1</field>
            <field name="name">Borrador</field>
            <field name="categoria">approval</field>
            <field name="nombre_boton">Pasar en Proceso</field>
            <field name="next_stage_id" eval="ref('dev_petty_cash.state_progress')"/>
        </record>

    </data>
</odoo>


