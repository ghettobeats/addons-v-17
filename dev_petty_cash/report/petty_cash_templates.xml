    <template id="petty_cash_template_detalle">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.company_id.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-call="dev_petty_cash.petty_cash_template_detalle_document" t-lang="lang"/>
            </t>
        </t>
    </template>
