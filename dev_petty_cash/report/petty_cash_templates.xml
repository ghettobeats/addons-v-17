                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.expense_lines" t-as="inv">
                            <tr>
                                <td><span t-field="inv.date"/></td>
                                <td><span t-field="inv.partner_id.name"/></td>
                                <td><span t-field="inv.payment_reference"/></td>
                                <td><span t-field="inv.employee_id.name"/></td>
                                <td><span t-field="inv.analytic_account_id.name"/></td>
