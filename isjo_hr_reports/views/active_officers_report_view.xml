<odoo>

    <!-- ─── Tree ─────────────────────────────────────────────────────────── -->
    <record id="view_isjo_active_officers_report_tree" model="ir.ui.view">
        <field name="name">isjo.active.officers.report.tree</field>
        <field name="model">isjo.active.officers.report</field>
        <field name="arch" type="xml">
            <tree string="Empleados Activos" create="false" delete="false" edit="false">
                <field name="x_cod_card"              string="Código"           />
                <field name="x_employee_name"         string="Empleado"         />
                <field name="x_cedula"                string="Cédula"           optional="show"/>
                <field name="x_gender"                string="Género"           optional="hide"/>
                <field name="x_department_name"       string="Departamento"     optional="show"/>
                <field name="x_puesto"                string="Puesto"           optional="show"/>
                <field name="x_clase"                 string="Clase"            optional="show"/>
                <field name="x_region"                string="Región"           optional="show"/>
                <field name="x_zona"                  string="Zona"             optional="show"/>
                <field name="x_fecha_ingreso"         string="Fecha Ingreso"    optional="show"/>
                <field name="x_fecha_inicio_contrato" string="Inicio Contrato"  optional="hide"/>
                <field name="x_dias_antiguedad"       string="Días Antigüedad"  optional="hide"/>
                <field name="x_anos_antiguedad"       string="Años"             optional="show"/>
                <field name="x_vigencia"              string="Vigencia"         optional="show"/>
                <field name="x_date"                                             invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ─── Search ───────────────────────────────────────────────────────── -->
    <record id="view_isjo_active_officers_report_search" model="ir.ui.view">
        <field name="name">isjo.active.officers.report.search</field>
        <field name="model">isjo.active.officers.report</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="x_employee_name"   string="Empleado"/>
                <field name="x_cedula"          string="Cédula"/>
                <field name="x_cod_card"        string="Código"/>
                <field name="x_department_name" string="Departamento"/>
                <field name="x_puesto"          string="Puesto"/>
                <field name="x_region"          string="Región"/>
                <field name="x_zona"            string="Zona"/>
                <field name="x_clase"           string="Clase"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Departamento" name="group_dept"   context="{'group_by': 'x_department_name'}"/>
                    <filter string="Puesto"       name="group_job"    context="{'group_by': 'x_puesto'}"/>
                    <filter string="Clase"        name="group_class"  context="{'group_by': 'x_clase'}"/>
                    <filter string="Región"       name="group_region" context="{'group_by': 'x_region'}"/>
                    <filter string="Zona"         name="group_zone"   context="{'group_by': 'x_zona'}"/>
                    <filter string="Género"       name="group_gender" context="{'group_by': 'x_gender'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Action ───────────────────────────────────────────────────────── -->
    <record id="action_isjo_active_officers_report" model="ir.actions.act_window">
        <field name="name">Empleados Activos</field>
        <field name="res_model">isjo.active.officers.report</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_isjo_active_officers_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay empleados activos registrados.
            </p>
        </field>
    </record>

    <!-- ─── Menu ─────────────────────────────────────────────────────────── -->
    <menuitem id="menu_isjo_active_officers_report"
              name="Empleados Activos"
              parent="menu_isjo_hr_reports_root"
              action="action_isjo_active_officers_report"
              sequence="10"/>

</odoo>
