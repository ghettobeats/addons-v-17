<odoo>

    <!-- ─── Tree ─────────────────────────────────────────────────────────── -->
    <record id="view_isjo_terminated_officers_report_tree" model="ir.ui.view">
        <field name="name">isjo.terminated.officers.report.tree</field>
        <field name="model">isjo.terminated.officers.report</field>
        <field name="arch" type="xml">
            <tree string="Desvinculaciones" create="false" delete="false" edit="false">
                <field name="x_cod_card"              string="Código"            />
                <field name="x_employee_name"         string="Empleado"          />
                <field name="x_cedula"                string="Cédula"            optional="show"/>
                <field name="x_gender"                string="Género"            optional="hide"/>
                <field name="x_fecha_cese"            string="Fecha de Cese"     />
                <field name="x_mes_cese"              string="Mes"               optional="show"/>
                <field name="x_ano_cese"              string="Año"               optional="show"/>
                <field name="x_motivo_salida"         string="Motivo de Salida"  optional="show"/>
                <field name="x_dias_desde_cese"       string="Días desde Cese"   optional="show"/>
                <field name="x_department_name"       string="Departamento"      optional="show"/>
                <field name="x_puesto"                string="Puesto"            optional="show"/>
                <field name="x_clase"                 string="Clase"             optional="show"/>
                <field name="x_region"                string="Región"            optional="show"/>
                <field name="x_zona"                  string="Zona"              optional="show"/>
                <field name="x_fecha_ingreso"         string="Fecha Ingreso"     optional="hide"/>
                <field name="x_dias_trabajados"       string="Días Trabajados"   optional="hide"/>
                <field name="x_anos_antiguedad"       string="Años Antigüedad"   optional="show"/>
                <field name="x_estado_empleado"       string="Estado"            optional="show"/>
                <field name="x_departure_date"                                    invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ─── Search ───────────────────────────────────────────────────────── -->
    <record id="view_isjo_terminated_officers_report_search" model="ir.ui.view">
        <field name="name">isjo.terminated.officers.report.search</field>
        <field name="model">isjo.terminated.officers.report</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="x_employee_name"   string="Empleado"/>
                <field name="x_cedula"          string="Cédula"/>
                <field name="x_motivo_salida"   string="Motivo de Salida"/>
                <field name="x_department_name" string="Departamento"/>
                <field name="x_mes_cese"        string="Mes"/>
                <field name="x_region"          string="Región"/>
                <field name="x_zona"            string="Zona"/>
                <!-- Filtros rápidos por período -->
                <filter string="Últimos 30 días"
                        name="filter_30d"
                        domain="[('x_departure_date','&gt;=', (context_today()-datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Últimos 3 meses"
                        name="filter_3m"
                        domain="[('x_departure_date','&gt;=', (context_today()-datetime.timedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <filter string="Este año"
                        name="filter_year"
                        domain="[('x_ano_cese','=', context_today().year)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Mes de Cese"      name="group_mes"    context="{'group_by': 'x_mes_cese'}"/>
                    <filter string="Año de Cese"      name="group_ano"    context="{'group_by': 'x_ano_cese'}"/>
                    <filter string="Motivo de Salida" name="group_motivo" context="{'group_by': 'x_motivo_salida'}"/>
                    <filter string="Departamento"     name="group_dept"   context="{'group_by': 'x_department_name'}"/>
                    <filter string="Puesto"           name="group_job"    context="{'group_by': 'x_puesto'}"/>
                    <filter string="Clase"            name="group_class"  context="{'group_by': 'x_clase'}"/>
                    <filter string="Región"           name="group_region" context="{'group_by': 'x_region'}"/>
                    <filter string="Zona"             name="group_zone"   context="{'group_by': 'x_zona'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Action ───────────────────────────────────────────────────────── -->
    <record id="action_isjo_terminated_officers_report" model="ir.actions.act_window">
        <field name="name">Desvinculaciones</field>
        <field name="res_model">isjo.terminated.officers.report</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_isjo_terminated_officers_report_search"/>
        <field name="context">{'search_default_filter_30d': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay empleados desvinculados en el período seleccionado.
            </p>
        </field>
    </record>

    <!-- ─── Menu ─────────────────────────────────────────────────────────── -->
    <menuitem id="menu_isjo_terminated_officers_report"
              name="Desvinculaciones"
              parent="menu_isjo_hr_reports_root"
              action="action_isjo_terminated_officers_report"
              sequence="30"/>

</odoo>
