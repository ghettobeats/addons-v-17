<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="relacion_pagos_personal">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <t t-call="mitur_reports.custom_header_relacion_pago" />
                    <div class="page">
                        <h2 class="text-center">Relación de Pago a Personal</h2>
                        <h3 class="text-center">Crédito a Cuenta</h3>
                        <div class="font-weight-bold">
                            Fecha:
                            <span t-field="o.date" />
                        </div>
                        <div class="font-weight-bold">
                            Cuenta Origen:
                            <span t-field="o.journal_id.bank_account_id" />
                        </div>
                    <!--<div class="font-weight-bold"> 
                            Total:
                            <span t-field="o.amount" />
                        </div>-->
                        <br />
                        <h4>Concepto</h4>
                        <p>
                            <span t-field="o.name" />
                        </p>
                        <br />
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th style="width: 150px;"># Cédula</th>
                                    <th style="width: 250px;">Nombre</th>
                                    <th>Cargo</th>
                                    <th>Cuenta Destino</th>
                                    <th>Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.payment_ids" t-as="move">
                                    <td>
                                        <span t-esc="move_index + 1" />
                                    </td>
                                    <td style="width: 150px;">
                                        <span t-field="move.partner_id.employee_ids.identification_id" />
                                    </td>
                                    <td style="width: 250px;">
                                        <span t-field="move.partner_id" />
                                    </td>
                                    <td>
                                        <span t-field="move.partner_id.employee_ids.job_title" />
                                    </td>
                                    <td>
                                        <span t-field="move.partner_bank_id" />
                                    </td>
                                    <td>
                                        <span t-field="move.amount" />
                                    </td>
                                </tr>
                                <tfoot>
                                    <tr>
                                        <td class="font-weight-bold">
                                            Total:
                                        </td>
                                        <td />
                                        <td />
                                        <td />
                                        <td />
                                        <td class="font-weight-bold">
                                            <t t-set="sum_row" t-value="0" />
                                            <t t-foreach="o.payment_ids" t-as="move">
                                                <t t-set="sum_row" t-value="sum_row+move.amount" />
                                            </t>
                                            <span t-esc="o.currency_id.symbol" />&amp;nbsp;<span t-esc="sum_row" t-options='{"widget": "float", "precision": 2}' />
                                        </td>
                                    </tr>
                                </tfoot>
                            </tbody>
                        </table>
                        <br />
                    </div>
                    <t t-call="mitur_reports.report_footer_relacion_empleados" />
                </t>
            </t>
        </template>
    </data>
</odoo>