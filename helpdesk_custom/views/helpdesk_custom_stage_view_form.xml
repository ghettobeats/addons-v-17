<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_custom_stage_view_form" model="ir.ui.view">
        <field name="name">helpdesk_custom_stage_view_form</field>
        <field name="model">helpdesk.stage</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_stage_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence']" position="after">
                <field name="isFinalStage"/>
            </xpath>
        </field>
    </record>
</odoo>